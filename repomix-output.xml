import { NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";

export async function GET(req: Request) {
  try {
    const { searchParams } = new URL(req.url);
    const partyId = searchParams.get("partyId");

    if (!partyId) {
      return NextResponse.json({ error: "Party ID is required for import" }, { status: 400 });
    }

    // 1. Fetch lots that are out (balanceQty: 0) but have pending billing days.
    // Nill Lot condition: physical balance is 0, but either NEVER billed (uptoDate: null) 
    // OR billed partially before physical dispatch (uptoDate < gpDate).
    const lots = await prisma.lot.findMany({
      where: {
        partyId,
        balanceQty: 0,
        OR: [
          { uptoDate: null },
          // Agar kisi ne beech mein balance bill banaya ho, toh uptoDate lag jata hai. 
          // Usko filter karne ke liye specific query (Handle on processing side mapping below)
        ]
      },
      include: {
        item: { 
          include: { 
            itemUnits: true // Rent & Labour master rates
          } 
        },
        unit: true,
        // Get the latest Gate Pass entry to determine the final end-date for rent
        outwardEntries: { 
          orderBy: { gpDate: 'desc' }, 
          take: 1 
        }
      },
      orderBy: {
        arrivalDate: 'asc' // Purana maal pehle bill hoga
      }
    });

    const result = lots.map(lot => {
      // Find the specific rate config for the packaging unit (e.g. Jute Bag vs Peti)
      const config = lot.item.itemUnits.find(u => u.unitId === lot.unitId);
      
      // Determine the final end date. If no GP exists (manual adjustment), use today's date.
      const finalGPDate = lot.outwardEntries.length > 0 
        ? lot.outwardEntries[0].gpDate.toISOString() 
        : new Date().toISOString();

      return {
        lotId: lot.id,
        lotNo: lot.lotNo,
        marka: lot.marka || "-", // Included marka for frontend grid consistency
        
        // Item Mapping
        itemName: lot.item.name,
        itemId: lot.item.id,
        
        // Unit/Packing Mapping (Crucial for Special Rates Override)
        packing: lot.unit.name,
        unitId: lot.unit.id, 
        
        // Dates & References
        gpNo: lot.outwardEntries[0]?.gpNo || "NA",
        mrDate: lot.arrivalDate.toISOString(), // Standardized
        gpDate: finalGPDate,
        uptoDate: lot.uptoDate ? lot.uptoDate.toISOString() : null, // Added for period calc reference
        
        // Quantities & Rates
        qty: lot.receivedQty, // Nill lot means entire received qty is billed
        rentRate: Number(config?.rentRate || 0),
        labRate: Number(config?.labourRate || 0),
        
        // Calculated Fields (Frontend will overwrite these on click)
        prd: 0, 
        rentAmt: 0,
        labourAmt: 0
      };
    });

    return NextResponse.json(result);

  } catch (error: any) {
    console.error("NILL_LOT_IMPORT_ERR:", error);
    return NextResponse.json({ error: "Failed to fetch unbilled lots from warehouse" }, { status: 500 });
  }
}



