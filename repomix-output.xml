<file path="app/outward/update-details/page.tsx">
"use client";

import React, { useState, useCallback } from "react";
import { Search, Edit3, Save, Printer, ArrowLeft, RefreshCw, X, Loader2, CheckCircle2 } from "lucide-react";
import { toast } from "react-hot-toast";
import { formatDate } from "@/lib/utils";

// STRICT TYPES
interface GPUpdateRecord {
  id: string;
  gpNo: string;
  gpDate: string;
  transportRequired: boolean;
  grNo: string;
  vehicleNo: string;
  personName: string;
  remarks?: string;
}

export default function UpdateGPDetailsPage() {
  const [range, setRange] = useState({ from: "", to: "" });
  const [records, setRecords] = useState<GPUpdateRecord[]>([]);
  const [loading, setLoading] = useState(false);
  const [isSaving, setIsSaving] = useState(false);
  
  // Track local changes before bulk save
  const [editingRows, setEditingRows] = useState<Record<string, GPUpdateRecord>>({});

  // 1. SEARCH LOGIC (Hits /api/outward/update-gp)
  const handleSearch = async () => {
    if (!range.from || !range.to) return toast.error("Kripya GP No. ki range bhariye!");
    setLoading(true);
    try {
      const res = await fetch(`/api/outward/update-gp?fromGp=${range.from}&toGp=${range.to}`);
      const data = await res.json();
      
      if (res.ok) {
        setRecords(data);
        // Map initial data to editing state
        const initialEditState: Record<string, GPUpdateRecord> = {};
        data.forEach((r: GPUpdateRecord) => {
          initialEditState[r.id] = { ...r };
        });
        setEditingRows(initialEditState);
        
        if (data.length === 0) toast.error("Is range mein koi records nahi mile!");
      }
    } catch (err) {
      toast.error("Data load karne mein galti hui!");
    } finally {
      setLoading(false);
    }
  };

  // 2. INLINE CHANGE HANDLER
  const handleChange = (id: string, field: keyof GPUpdateRecord, value: any) => {
    setEditingRows(prev => ({
      ...prev,
      [id]: { 
        ...prev[id], 
        [field]: field === "vehicleNo" ? value.toUpperCase() : value 
      }
    }));
  };

  // 3. BULK UPDATE (The Red Save Button)
  const handleBulkUpdate = async () => {
    const updates = Object.values(editingRows);
    if (updates.length === 0) return toast.error("Pehle koi badlav toh kijiye!");

    setIsSaving(true);
    const loadId = toast.loading("Synchronizing Gate Pass details...");
    try {
      const res = await fetch("/api/outward/update-gp", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ updates })
      });

      if (res.ok) {
        toast.success("All GP Records synchronized successfully!", { id: loadId });
        handleSearch(); // Refresh to get fresh data
      } else {
        toast.error("Update failed. Please check inputs.", { id: loadId });
      }
    } catch (err) {
      toast.error("Network Error! Server check karein.", { id: loadId });
    } finally {
      setIsSaving(false);
    }
  };

  return (
    <div className="space-y-4 text-[11px] animate-in fade-in duration-500">
      
      {/* Visual Header */}
      <div className="bg-[#5d5fb1] text-white p-3 rounded-t-lg flex justify-between items-center shadow-md no-print">
        <h2 className="font-bold uppercase flex items-center gap-2 tracking-widest">
          <RefreshCw size={16}/> MINOR CHANGES OUTWARD ENTRY (GP LOGS)
        </h2>
        <button 
          onClick={handleBulkUpdate}
          disabled={isSaving || records.length === 0}
          className="bg-red-600 hover:bg-red-700 px-8 py-1.5 rounded font-black flex items-center gap-2 uppercase transition-all shadow-lg active:scale-95 disabled:opacity-50"
        >
          {isSaving ? <Loader2 className="animate-spin" size={14}/> : <Save size={14}/>} 
          Sync All Changes
        </button>
      </div>

      {/* SEARCH BOX (Image 84 Mapping) */}
      <div className="bg-white p-6 border rounded shadow-sm flex flex-wrap items-end gap-6 no-print">
        <div className="space-y-1">
          <label className="font-bold text-gray-400 uppercase block tracking-widest text-[9px]">From GP No</label>
          <input 
            className="border-2 border-slate-100 p-2 rounded w-44 outline-none focus:border-indigo-500 font-black text-indigo-700 shadow-inner" 
            placeholder="Start Range"
            value={range.from} 
            onChange={e => setRange({...range, from: e.target.value})} 
          />
        </div>
        <div className="space-y-1">
          <label className="font-bold text-gray-400 uppercase block tracking-widest text-[9px]">To GP No</label>
          <input 
            className="border-2 border-slate-100 p-2 rounded w-44 outline-none focus:border-indigo-500 font-black text-indigo-700 shadow-inner" 
            placeholder="End Range"
            value={range.to} 
            onChange={e => setRange({...range, to: e.target.value})} 
          />
        </div>
        <button 
          onClick={handleSearch}
          disabled={loading}
          className="bg-indigo-600 text-white px-10 py-2.5 rounded font-black uppercase hover:bg-indigo-700 flex items-center gap-2 shadow-lg transition-all active:scale-95 disabled:opacity-50"
        >
          {loading ? <Loader2 className="animate-spin" size={16}/> : <Search size={16}/>} 
          Search Outward Logs
        </button>
      </div>

      {/* BRANDING SECTION (Center of Image 84) */}
      <div className="text-center py-5 bg-white border rounded shadow-sm relative">
         <h1 className="text-2xl font-black text-slate-800 uppercase tracking-tighter italic">Cold Storage ERP</h1>
         <p className="text-[10px] text-gray-500 font-bold uppercase tracking-widest">
            Audit Control & Document Correction Interface
         </p>
         <div className="flex justify-center gap-6 text-[10px] font-black text-indigo-700 mt-2">
           <span className="bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100">PAN: AAXFV5416G</span>
           <span className="bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100">GST: 07AAXFV5416G1ZO</span>
         </div>
      </div>

      {/* DATA GRID (Exact 6 Columns Mapping from Image 84) */}
      <div className="bg-white border rounded shadow-2xl overflow-x-auto min-h-[400px]">
        <table className="w-full border-collapse text-left min-w-[1200px]">
          <thead className="bg-[#b4b6e4] text-slate-800 uppercase font-black text-[9px] sticky top-0 z-10 shadow-sm">
            <tr>
              <th className="p-3 border-r border-slate-300 w-32">GP NUMBER</th>
              <th className="p-3 border-r border-slate-300 w-48 text-center">TRANSPORT REQUIRED</th>
              <th className="p-3 border-r border-slate-300 w-40 text-center">GR NUMBER</th>
              <th className="p-3 border-r border-slate-300 w-40 text-center">TRUCK / VEHICLE NO</th>
              <th className="p-3 border-r border-slate-300 w-48">DELIVERY PERSON</th>
              <th className="p-3 border-r border-slate-300">ADMIN REMARKS</th>
            </tr>
          </thead>
          <tbody>
            {loading ? (
              <tr><td colSpan={6} className="p-24 text-center font-bold text-indigo-700 animate-pulse text-lg uppercase">Scanning Gate Pass Registry...</td></tr>
            ) : records.length === 0 ? (
              <tr><td colSpan={6} className="p-24 text-center text-gray-300 italic font-medium uppercase tracking-[5px]">Enter GP Number range and search to begin synchronization</td></tr>
            ) : records.map((row) => (
              <tr key={row.id} className={`border-b transition-colors hover:bg-slate-50 ${editingRows[row.id] !== row ? 'bg-indigo-50/40' : ''}`}>
                <td className="p-3 border-r border-slate-200 font-black text-indigo-800 text-sm">
                   {row.gpNo}
                   <div className="text-[8px] text-gray-400 font-normal">{formatDate(row.gpDate)}</div>
                </td>
                
                {/* TRANSPORT REQ EDIT */}
                <td className="p-2 border-r border-slate-200 text-center">
                  <select 
                    className="w-full border-2 border-slate-100 p-1.5 rounded bg-white font-bold text-blue-600 outline-none focus:border-indigo-400"
                    value={editingRows[row.id]?.transportRequired ? "Yes" : "No"}
                    onChange={e => handleChange(row.id, "transportRequired", e.target.value === "Yes")}
                  >
                    <option value="Yes">YES (REQ)</option>
                    <option value="No">NO (SELF)</option>
                  </select>
                </td>

                {/* GR NO EDIT */}
                <td className="p-2 border-r border-slate-200">
                  <input 
                    className="w-full border-2 border-slate-100 p-1.5 rounded outline-none focus:border-indigo-400 font-bold text-center" 
                    placeholder="Enter GR No"
                    value={editingRows[row.id]?.grNo || ""}
                    onChange={e => handleChange(row.id, "grNo", e.target.value)}
                  />
                </td>

                {/* VEHICLE NO EDIT */}
                <td className="p-2 border-r border-slate-200">
                  <input 
                    className="w-full border-2 border-slate-100 p-1.5 rounded font-mono uppercase outline-none focus:border-indigo-400 font-bold text-center text-slate-700" 
                    placeholder="UP-14-XXXX"
                    value={editingRows[row.id]?.vehicleNo || ""}
                    onChange={e => handleChange(row.id, "vehicleNo", e.target.value)}
                  />
                </td>

                {/* PERSON EDIT */}
                <td className="p-2 border-r border-slate-200">
                  <input 
                    className="w-full border-2 border-slate-100 p-1.5 rounded outline-none focus:border-indigo-400 font-bold" 
                    placeholder="Driver/Representative"
                    value={editingRows[row.id]?.personName || ""}
                    onChange={e => handleChange(row.id, "personName", e.target.value)}
                  />
                </td>

                {/* REMARKS EDIT */}
                <td className="p-2">
                  <input 
                    className="w-full border-2 border-slate-100 p-1.5 rounded outline-none focus:border-indigo-400 italic" 
                    placeholder="Internal Audit Notes..."
                    value={editingRows[row.id]?.remarks || ""}
                    onChange={e => handleChange(row.id, "remarks", e.target.value)}
                  />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* Footer Audit Controls */}
      <div className="p-3 bg-[#1e293b] text-white rounded-lg flex justify-between items-center shadow-xl no-print">
         <p className="flex items-center gap-2 font-bold uppercase tracking-widest text-[9px]">
           <CheckCircle2 size={14} className="text-green-400"/> System Integrity: Operational Edits Logged
         </p>
         <button onClick={() => window.print()} className="bg-white/10 hover:bg-white/20 p-1.5 rounded transition-all">
            <Printer size={16}/>
         </button>
      </div>
    </div>
  );
}
</file>

