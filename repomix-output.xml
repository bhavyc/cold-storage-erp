            </tfoot>
          )}
        </table>
      </div>

      {/* FOOTER INFO BAR */}
      <div className="flex justify-between items-center bg-slate-50 p-2 border rounded shadow-inner opacity-60 no-print">
         <p className="font-bold uppercase tracking-widest text-[9px] flex items-center gap-2">
