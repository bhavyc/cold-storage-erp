      if (data.length === 0) toast.error("Is selection mein koi bill nahi mila!");
    } catch (err) {
      toast.error("Data load karne mein galti hui!");
    } finally {
      setLoading(false);
    }
  }, [filters]);

  // 3. QUICK RECEIPT LOGIC (The Red Rupee Function)
  const handleQuickReceipt = async (bill: any) => {
    if (bill.status === "Paid") return toast.error("Ye bill pehle se Paid hai!");
    
    if (!confirm(`Kya aap ₹${Number(bill.netAmount).toLocaleString()} ki receipt entry auto-post karna chahte hain?`)) return;
    
    const loadId = toast.loading("Processing payment & updating ledger...");
    try {
      const res = await fetch("/api/accounting/quick-receipt", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ 
            invoiceId: bill.id, 
            paymentMode: "CASH",
            ledgerId: "CASH_LEDGER_ID" // Backend should fetch this from SystemSettings
        })
      });

      if (res.ok) {
        toast.success("Payment Received! Invoice marked as PAID.", { id: loadId });
        handleSearch(); // Refresh list
      } else {
        const err = await res.json();
        toast.error(err.error || "Receipt failed", { id: loadId });
      }
    } catch (err) {
      toast.error("Network Error!", { id: loadId });
    }
  };

  return (
    <div className="space-y-4 text-[10px] animate-in fade-in duration-500">
      
      {/* FILTER BAR (Image 71 Exact Replication) */}
      <div className="bg-[#f0f1f7] p-5 border-2 border-slate-200 rounded-xl shadow-sm grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3 items-end no-print">
        <div>
          <label className="font-black text-slate-500 uppercase mb-1 block">Filter Type</label>
          <select className="w-full border-2 border-slate-200 p-1.5 rounded bg-white font-bold outline-none focus:border-indigo-400" value={filters.filterType} onChange={e => setFilters({...filters, filterType: e.target.value})}>
            <option>Party Wise</option>
            <option>Bill Wise</option>
          </select>
        </div>
        <div>
          <label className="font-black text-slate-500 uppercase mb-1 block">From Date</label>
          <input type="date" className="w-full border-2 border-slate-200 p-1.5 rounded outline-none focus:border-indigo-400" value={filters.fromDate} onChange={e => setFilters({...filters, fromDate: e.target.value})} />
        </div>
        <div>
          <label className="font-black text-slate-500 uppercase mb-1 block">To Date</label>
          <input type="date" className="w-full border-2 border-slate-200 p-1.5 rounded outline-none focus:border-indigo-400" value={filters.toDate} onChange={e => setFilters({...filters, toDate: e.target.value})} />
        </div>
        <div>
          <label className="font-black text-slate-500 uppercase mb-1 block text-indigo-700">Merchant Name</label>
          <select className="w-full border-2 border-indigo-100 p-1.5 rounded bg-white font-bold text-blue-900 outline-none" value={filters.partyId} onChange={e => setFilters({...filters, partyId: e.target.value})}>
            <option value="All">--- ALL MERCHANTS ---</option>
            {parties.map(p => <option key={p.id} value={p.id}>{p.tradeName}</option>)}
          </select>
        </div>
        <div>
          <label className="font-black text-slate-500 uppercase mb-1 block">Billing Type</label>
          <select className="w-full border-2 border-slate-200 p-1.5 rounded bg-white font-medium outline-none" value={filters.billingType} onChange={e => setFilters({...filters, billingType: e.target.value})}>
            <option value="All">All Types</option>
            <option value="Nill Lot">Nill Lot Bill</option>
            <option value="Monthly">Monthly Bill</option>
          </select>
        </div>
        <div>
          <label className="font-black text-slate-500 uppercase mb-1 block">Sorting</label>
          <select className="w-full border-2 border-slate-200 p-1.5 rounded bg-white font-medium outline-none" value={filters.sortData} onChange={e => setFilters({...filters, sortData: e.target.value})}>
            <option>NEW TO OLD</option>
            <option>OLD TO NEW</option>
          </select>
        </div>
        <div className="flex gap-1.5">
          <button 
            onClick={handleSearch} 
            disabled={loading}
            className="bg-red-600 text-white px-4 py-1.5 rounded font-black uppercase shadow-md flex-1 hover:bg-red-700 transition-all active:scale-95"
          >
            {loading ? <Loader2 className="animate-spin mx-auto" size={14}/> : "SEARCH"}
          </button>
          <button className="bg-green-600 text-white p-1.5 rounded shadow hover:bg-green-700 transition-all"><FileSpreadsheet size={16}/></button>
          <button onClick={() => window.print()} className="bg-red-500 text-white p-1.5 rounded shadow hover:bg-red-600 transition-all"><Printer size={16}/></button>
        </div>
      </div>

      {/* BRANDING HEADER */}
      <div className="bg-white p-6 border-2 border-slate-100 rounded-lg shadow-sm text-center space-y-1 relative overflow-hidden">
        <div className="absolute -left-4 -top-4 opacity-10 rotate-12"><FileText size={100}/></div>
        {/* <h1 className="text-3xl font-black text-slate-800 uppercase tracking-tighter italic">Cold Storage</h1> */}
        <p className="text-[10px] text-gray-400 font-bold uppercase tracking-widest italic">Inventory & Revenue Management Core</p>
        <div className="flex justify-center gap-6 text-[10px] font-black text-indigo-600 mt-2">
           <span className="bg-indigo-50 px-3 py-0.5 rounded border border-indigo-100 uppercase">PAN: AAXFV5416G</span>
           <span className="bg-indigo-50 px-3 py-0.5 rounded border border-indigo-100 uppercase">GST: 07AAXFV5416G1ZO</span>
        </div>
        <p className="text-xs font-black text-slate-700 mt-5 border-b-2 border-dashed border-indigo-200 inline-block pb-1 uppercase tracking-[10px]">BILL SUMMARY BOOK</p>
      </div>

      {/* DATA TABLE (12 Columns Exact Replication) */}
      <div className="bg-white border-2 border-slate-100 rounded-lg shadow-2xl overflow-hidden min-h-[450px]">
        <table className="w-full text-left border-collapse">
          <thead className="bg-[#b4b6e4] text-slate-800 uppercase font-black text-[9px] border-b-2 border-indigo-200 sticky top-0 z-10">
            <tr>
              <th className="p-3 border-r border-indigo-100">BILL DATE</th>
              <th className="p-3 border-r border-indigo-100">TYPE</th>
              <th className="p-3 border-r border-indigo-100">BILL NO</th>
              <th className="p-3 border-r border-indigo-100">MERCHANT NAME</th>
              <th className="p-3 border-r border-indigo-100">GSTIN</th>
              <th className="p-3 border-r border-indigo-100 text-center">QTY</th>
              <th className="p-3 border-r border-indigo-100 text-right">RENT (₹)</th>
              <th className="p-3 border-r border-indigo-100 text-right">LABOUR (₹)</th>
              <th className="p-3 border-r border-indigo-100 text-right">GST (₹)</th>
              <th className="p-3 border-r border-indigo-100 text-right bg-indigo-50">NET AMT (₹)</th>
              <th className="p-3 border-r border-indigo-100 text-center">STATUS</th>
              <th className="p-3 text-center">ACTIONS</th>
            </tr>
          </thead>
          <tbody>
            {loading ? (
              <tr><td colSpan={12} className="p-24 text-center font-bold text-indigo-700 animate-pulse text-lg uppercase tracking-widest">Scanning Financial Records...</td></tr>
            ) : bills.length === 0 ? (
              <tr><td colSpan={12} className="p-24 text-center text-gray-400 italic">No invoices found. Use filters to search the bill book.</td></tr>
            ) : bills.map((bill) => {
              const gstAmt = Number(bill.cgst) + Number(bill.sgst) + Number(bill.igst);
              return (
                <tr key={bill.id} className="border-b hover:bg-indigo-50/50 transition-all font-bold group even:bg-slate-50/30">
                  <td className="p-3 border-r border-slate-100 font-mono text-gray-500">{formatDate(bill.date)}</td>
                  <td className="p-3 border-r border-slate-100 italic text-[9px] text-slate-400 uppercase">{bill.billingType}</td>
                  <td className="p-3 border-r border-slate-100 font-black text-indigo-700 uppercase">{bill.invoiceNo}</td>
                  <td className="p-3 border-r border-slate-100 font-black text-slate-700 uppercase truncate max-w-[200px]">{bill.party.tradeName}</td>
                  <td className="p-3 border-r border-slate-100 font-mono text-[9px] text-gray-400">{bill.party.gstNo || "N/A"}</td>
                  <td className="p-3 border-r border-slate-100 text-center font-black text-blue-600">{bill.totalQty}</td>
                  <td className="p-3 border-r border-slate-100 text-right text-green-700">{Number(bill.totalRent).toFixed(2)}</td>
                  <td className="p-3 border-r border-slate-100 text-right text-indigo-600">{Number(bill.totalLabour).toFixed(2)}</td>
                  <td className="p-3 border-r border-slate-100 text-right text-orange-600">{gstAmt.toFixed(2)}</td>
                  <td className="p-3 border-r border-slate-100 text-right font-black text-slate-900 bg-indigo-50/50">
                    ₹ {Number(bill.netAmount).toLocaleString('en-IN', { minimumFractionDigits: 2 })}
                  </td>
                  <td className="p-3 border-r border-slate-100 text-center">
                     <span className={`px-3 py-1 rounded-full text-[8px] font-black uppercase tracking-tighter ${bill.status === 'Paid' ? 'bg-green-100 text-green-700 border border-green-200' : 'bg-red-100 text-red-700 border border-red-200'}`}>
                       {bill.status}
                     </span>
                  </td>
                  <td className="p-3 text-center">
                    <div className="flex justify-center gap-2">
                       <button 
                         onClick={() => handleQuickReceipt(bill)} 
                         title="Post Quick Payment" 
                         className={`p-1.5 rounded shadow-md transition-all active:scale-90 ${bill.status === 'Paid' ? 'bg-gray-100 text-gray-400 cursor-not-allowed' : 'bg-red-600 text-white hover:bg-red-700'}`}
                       >
                          <IndianRupee size={12}/>
                       </button>
                       <button className="text-blue-500 hover:scale-125 transition-transform"><Edit3 size={14}/></button>
                       <button onClick={() => window.print()} className="text-slate-400 hover:text-black transition-all"><Printer size={14}/></button>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>

          {/* TABLE FOOTER (Aggregates) */}
          {bills.length > 0 && (
            <tfoot className="bg-[#1e293b] text-white font-black uppercase text-[10px]">
               <tr>
                 <td colSpan={5} className="p-3 text-right tracking-[3px] italic border-r border-slate-700">Page Aggregate Totals</td>
                 <td className="p-3 text-center text-blue-400 border-r border-slate-700">{bills.reduce((s, r) => s + (Number(r.totalQty) || 0), 0)}</td>
                 <td className="p-3 text-right text-green-400 border-r border-slate-700">{bills.reduce((s, r) => s + (Number(r.totalRent) || 0), 0).toFixed(2)}</td>
                 <td className="p-3 text-right text-indigo-400 border-r border-slate-700">{bills.reduce((s, r) => s + (Number(r.totalLabour) || 0), 0).toFixed(2)}</td>
                 <td className="p-3 text-right text-orange-400 border-r border-slate-700">{(bills.reduce((s, r) => s + (Number(r.cgst) + Number(r.sgst) + Number(r.igst) || 0), 0)).toFixed(2)}</td>
                 <td className="p-3 text-right text-yellow-400 bg-black">₹ {bills.reduce((s, r) => s + (Number(r.netAmount) || 0), 0).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                 <td colSpan={2}></td>
               </tr>
            </tfoot>
          )}
        </table>
      </div>

      {/* FOOTER INFO */}
      <div className="flex justify-between items-center bg-[#f8f9fa] p-2 border rounded shadow-inner opacity-50 no-print">
         <p className="font-bold uppercase tracking-widest text-[9px] flex items-center gap-2">
           <AlertCircle size={14}/> Total Invoices: {bills.length} | Outstanding monitored by Credit Limit logic.
         </p>
         <p className="text-[8px] font-black italic uppercase tracking-[10px]">Cold Storage Financial Core</p>
      </div>
    </div>
  );
}
