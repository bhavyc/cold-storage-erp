<file path="app/location/shifting-report/page.tsx">
"use client";

import React, { useEffect, useState, useCallback, useMemo } from "react";
import { Search, Printer, FileSpreadsheet, History, Plus, Loader2, RefreshCw, AlertCircle, MapPin, ArrowRight } from "lucide-react";
import { toast } from "react-hot-toast";
import { useRouter } from "next/navigation";
import { formatDate } from "@/lib/utils";

export default function ShiftingRegisterPage() {
  const router = useRouter();
  const [data, setData] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  
  // Masters for dropdowns
  const [parties, setParties] = useState<any[]>([]);
  const [items, setItems] = useState<any[]>([]);
  const [chambers, setChambers] = useState<any[]>([]);

  // 1. FILTER STATES
  const [filters, setFilters] = useState({
    fromDate: "2025-04-01",
    toDate: new Date().toISOString().split('T')[0],
    partyId: "All",
    itemId: "All",
    chamberId: "All"
  });

  // 2. Load Masters
  useEffect(() => {
    const loadMasters = async () => {
      try {
        const [p, i, c] = await Promise.all([
          fetch("/api/masters/party").then(res => res.json()),
          fetch("/api/masters/items").then(res => res.json()),
          fetch("/api/masters/chambers").then(res => res.json())
        ]);
        setParties(p || []);
        setItems(i || []);
        setChambers(c || []);
      } catch (err) {
        console.error("Dropdown load failed");
      }
    };
    loadMasters();
  }, []);

  // 3. SEARCH FUNCTION
  const handleSearch = useCallback(async () => {
    setLoading(true);
    const query = new URLSearchParams(filters).toString();
    try {
      const res = await fetch(`/api/reports/shifting?${query}`);
      if (!res.ok) throw new Error("Fetch failed");
      const json = await res.json();
      setData(json);
      if (json.length === 0) toast.error("Is selection mein koi movement record nahi mila!");
      else toast.success(`${json.length} Movement logs found.`);
    } catch (err) {
      toast.error("Data load nahi ho paya!");
    } finally {
      setLoading(false);
    }
  }, [filters]);

  // 4. TOTALS AGGREGATE
  const totalShifted = useMemo(() => data.reduce((s, r) => s + (Number(r.qty) || 0), 0), [data]);

  return (
    <div className="space-y-4 text-[10px] animate-in fade-in duration-500">
      
      {/* Visual Header */}
      <div className="bg-[#5d5fb1] text-white p-3 rounded-t-lg flex justify-between items-center shadow-md no-print">
        <h2 className="font-bold uppercase flex items-center gap-2 tracking-[3px] text-xs">
          <History size={18}/> Material Shifting & Movement Register
        </h2>
        <button 
          onClick={() => router.push('/location/shifting-entry')}
          className="bg-red-600 hover:bg-red-700 px-5 py-1.5 rounded font-black uppercase text-[9px] shadow-lg flex items-center gap-2 transition-all active:scale-95"
        >
          <Plus size={14}/> Add New Shifting
        </button>
      </div>

      {/* FILTER BAR (Image 88 exact replication) */}
      <div className="bg-white p-6 border-2 border-indigo-50 rounded-b shadow-sm grid grid-cols-2 md:grid-cols-5 gap-4 items-end font-bold text-slate-700 no-print">
        <div>
          <label className="text-[9px] text-indigo-900 block mb-1 uppercase">From Date</label>
          <input type="date" className="w-full border-2 border-slate-100 p-1.5 rounded bg-white outline-none focus:border-indigo-400" value={filters.fromDate} onChange={e => setFilters({...filters, fromDate: e.target.value})} />
        </div>

        <div>
          <label className="text-[9px] text-indigo-900 block mb-1 uppercase">To Date</label>
          <input type="date" className="w-full border-2 border-slate-100 p-1.5 rounded bg-white outline-none focus:border-indigo-400" value={filters.toDate} onChange={e => setFilters({...filters, toDate: e.target.value})} />
        </div>

        <div>
          <label className="text-[9px] text-indigo-900 block mb-1 uppercase">Merchant / Party</label>
          <select className="w-full border-2 border-slate-100 p-1.5 rounded bg-white font-black text-blue-900 outline-none focus:border-indigo-400" value={filters.partyId} onChange={e => setFilters({...filters, partyId: e.target.value})}>
            <option value="All">--- ALL PARTIES ---</option>
            {parties.map(p => <option key={p.id} value={p.id}>{p.tradeName}</option>)}
          </select>
        </div>

        <div>
          <label className="text-[9px] text-indigo-900 block mb-1 uppercase">Item Name</label>
          <select className="w-full border-2 border-slate-100 p-1.5 rounded bg-white font-medium outline-none focus:border-indigo-400" value={filters.itemId} onChange={e => setFilters({...filters, itemId: e.target.value})}>
            <option value="All">All Items</option>
            {items.map(i => <option key={i.id} value={i.id}>{i.name}</option>)}
          </select>
        </div>

        <div className="flex gap-2">
          <div className="flex-1">
            <label className="text-[9px] text-indigo-900 block mb-1 uppercase">Source Chamber</label>
            <select className="w-full border-2 border-slate-100 p-1.5 rounded bg-white font-medium outline-none focus:border-indigo-400" value={filters.chamberId} onChange={e => setFilters({...filters, chamberId: e.target.value})}>
              <option value="All">All Chambers</option>
              {chambers.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}
            </select>
          </div>
          <button 
            disabled={loading}
            onClick={handleSearch}
            className="bg-red-600 text-white p-2 rounded shadow-md hover:bg-red-700 transition-all active:scale-90 flex items-center justify-center min-w-[40px] mb-0.5"
          >
            {loading ? <RefreshCw size={16} className="animate-spin" /> : <Search size={16}/>}
          </button>
        </div>
      </div>

      {/* LIVE AGGREGATE DISPLAY */}
      <div className="text-center py-2">
        <p className="bg-indigo-50 text-indigo-700 border border-indigo-200 inline-block px-12 py-1.5 rounded-full font-black text-[10px] shadow-sm uppercase tracking-widest">
          Total Material Moved (Selected Period) = <span className="text-red-600 ml-1">{totalShifted.toLocaleString()} BAGS</span>
        </p>
      </div>

      {/* DATA TABLE (All fields included as per database) */}
      <div className="bg-white border-2 border-slate-100 rounded-lg shadow-2xl overflow-x-auto min-h-[450px]">
        <table className="w-full text-left border-collapse min-w-[1400px]">
          <thead className="bg-[#b4b6e4] text-slate-800 uppercase font-black text-[9px] sticky top-0 z-10 shadow-sm">
            <tr>
              <th className="p-4 border-r border-indigo-200">Movement Date</th>
              <th className="p-4 border-r border-indigo-200">Shift Ref No</th>
              <th className="p-4 border-r border-indigo-200">Lot No</th>
              <th className="p-4 border-r border-indigo-200">Merchant Name</th>
              <th className="p-4 border-r border-indigo-200">Item Description</th>
              <th className="p-4 border-r border-indigo-200 text-red-600 bg-red-50/50 font-black">ORIGIN (FROM)</th>
              <th className="p-4 border-r border-indigo-200 text-green-700 bg-green-50/50 font-black">DESTINATION (TO)</th>
              <th className="p-4 border-r border-indigo-200 text-center font-black">QTY MOVED</th>
              <th className="p-4 text-center no-print">ACTION</th>
            </tr>
          </thead>
          <tbody>
            {loading ? (
              <tr><td colSpan={9} className="p-24 text-center font-bold text-indigo-700 animate-pulse text-lg uppercase tracking-widest">Compiling movement history logs...</td></tr>
            ) : data.length === 0 ? (
              <tr><td colSpan={9} className="p-24 text-center text-gray-400 italic font-medium uppercase tracking-widest">Adjust filters and click search to view audit trail.</td></tr>
            ) : (
              data.map((row) => (
                <tr key={row.id} className="border-b hover:bg-indigo-50/50 transition-all font-bold even:bg-slate-50/30 group">
                  <td className="p-4 border-r border-slate-100 text-gray-600 font-mono">{formatDate(row.date)}</td>
                  <td className="p-4 border-r border-slate-100 font-black text-indigo-700 uppercase">{row.shiftNo || "SFT-REG"}</td>
                  <td className="p-4 border-r border-slate-100 font-black text-blue-600">{row.lot?.lotNo}</td>
                  <td className="p-4 border-r border-slate-100 uppercase truncate max-w-[200px] text-slate-800">{row.lot?.party?.tradeName}</td>
                  <td className="p-4 border-r border-slate-100 uppercase">
                    <div className="text-slate-700">{row.lot?.item?.name}</div>
                    <div className="text-[8px] text-gray-400 font-normal">{row.lot?.unit?.name} | {row.lot?.marka}</div>
                  </td>
                  <td className="p-4 border-r border-slate-100 text-red-500 italic bg-red-50/10 text-[9px]">{row.fromLocation}</td>
                  <td className="p-4 border-r border-slate-100 text-green-600 font-black bg-green-50/10 text-[9px]">{row.toLocation}</td>
                  <td className="p-4 border-r border-slate-100 text-center font-black text-slate-900 text-sm bg-indigo-50/20">
                    {row.qty} <span className="text-[8px] font-normal text-gray-400">BAGS</span>
                  </td>
                  <td className="p-4 text-center no-print">
                     <button className="text-blue-600 hover:scale-125 transition-transform"><Printer size={16}/></button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
          
          {/* TOTALS FOOTER */}
          {data.length > 0 && (
            <tfoot className="bg-[#1e293b] text-white font-black text-xs uppercase">
               <tr>
                 <td colSpan={7} className="p-4 text-right tracking-[5px] italic border-r border-slate-700">Total Volume Shifted (Current Selection)</td>
                 <td className="p-4 text-center text-orange-400 font-black text-lg">{totalShifted} Bags</td>
                 <td></td>
               </tr>
            </tfoot>
          )}
        </table>
      </div>

      {/* FOOTER INFO BAR */}
      <div className="flex justify-between items-center bg-[#f8f9fa] p-3 border rounded shadow-inner opacity-60 no-print">
         <p className="font-bold uppercase tracking-widest text-[9px] flex items-center gap-2">
           <AlertCircle size={14} className="text-indigo-400"/> Movement Log Entries: {data.length}
         </p>
         <p className="text-[8px] font-black italic uppercase tracking-[10px]">Cold Storage Internal Audit Trail</p>
      </div>
    </div>
  );
}
</file>

<file path="app/location/update-location/page.tsx">
"use client";

import React, { useState, useEffect, useCallback } from "react";
import { Search, Save, MapPin, RefreshCw, Layers, Loader2, CheckCircle2, AlertTriangle, Printer, FileSpreadsheet } from "lucide-react";
import { toast } from "react-hot-toast";
import { formatDate } from "@/lib/utils";

export default function UpdateStockLocationPage() {
  const [range, setRange] = useState({ from: "", to: "" });
  const [records, setRecords] = useState<any[]>([]);
  const [chambers, setChambers] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [isSaving, setIsSaving] = useState(false);
  
  // Track edits and modified IDs
  const [editState, setEditState] = useState<Record<string, any>>({});
  const [modifiedIds, setModifiedIds] = useState<Set<string>>(new Set());

  // 1. LOAD CHAMBERS
  useEffect(() => {
    fetch("/api/masters/chambers").then(res => res.json()).then(setChambers);
  }, []);

  // 2. SEARCH LOGIC
  const handleSearch = async () => {
    if (!range.from || !range.to) return toast.error("Kripya Lot range bhariye!");
    setLoading(true);
    try {
      const res = await fetch(`/api/inventory/update-location?fromLot=${range.from}&toLot=${range.to}`);
      const data = await res.json();
      
      if (res.ok) {
        setRecords(data);
        // Initialize editable state
        const initialState: Record<string, any> = {};
        data.forEach((r: any) => { 
            initialState[r.id] = { 
                ...r,
                perUnitWgt: Number(r.perUnitWgt),
                truckNo: r.inwardEntry?.truckNo || "",
                deliveryPerson: r.inwardEntry?.deliveryPerson || ""
            }; 
        });
        setEditState(initialState);
        setModifiedIds(new Set());
        if (data.length === 0) toast.error("Is range mein koi stock nahi mila!");
      }
    } catch (err) {
        toast.error("Fetch error!");
    } finally {
      setLoading(false);
    }
  };

  // 3. INLINE EDIT HANDLER
  const handleInputChange = (id: string, field: string, val: any) => {
    setEditState(prev => ({
      ...prev,
      [id]: { ...prev[id], [field]: val }
    }));
    setModifiedIds(prev => new Set(prev).add(id));
  };

  // 4. BULK SAVE
  const handleUpdate = async () => {
    if (modifiedIds.size === 0) return toast.error("Pehle koi badlav karein!");

    setIsSaving(true);
    const loadId = toast.loading(`Updating ${modifiedIds.size} stock attributes...`);
    
    const updates = Array.from(modifiedIds).map(id => editState[id]);

    try {
      const res = await fetch("/api/inventory/update-location", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ updates })
      });

      if (res.ok) {
        toast.success("Warehouse Registry Synced!", { id: loadId });
        setModifiedIds(new Set());
        handleSearch();
      } else {
        toast.error("Update failed", { id: loadId });
      }
    } catch (err) {
      toast.error("Server Error!", { id: loadId });
    } finally {
      setIsSaving(false);
    }
  };

  return (
    <div className="space-y-4 text-[10px] animate-in fade-in duration-500">
      
      {/* HEADER ACTION BAR */}
      <div className="bg-[#5d5fb1] text-white p-3 rounded-t-lg flex justify-between items-center shadow-md no-print">
        <h2 className="font-bold uppercase flex items-center gap-2 tracking-[2px] text-xs">
          <Layers size={18}/> MASTER STOCK ATTRIBUTE & LOCATION CORRECTION
        </h2>
        <div className="flex gap-2">
            <button 
                onClick={handleUpdate}
                disabled={isSaving || modifiedIds.size === 0}
                className="bg-red-600 hover:bg-red-700 px-8 py-1.5 rounded font-black flex items-center gap-2 uppercase transition-all shadow-xl active:scale-95 disabled:opacity-50"
            >
                {isSaving ? <Loader2 className="animate-spin" size={14}/> : <Save size={14}/>} 
                Sync {modifiedIds.size > 0 ? `(${modifiedIds.size})` : ''} Changes
            </button>
        </div>
      </div>

      {/* FILTER BOX */}
      <div className="bg-white p-6 border-2 border-indigo-50 rounded shadow-sm flex flex-wrap items-end gap-6 no-print">
        <div className="space-y-1">
          <label className="font-black text-gray-400 uppercase text-[9px]">Start Lot No</label>
          <input className="border-2 border-slate-100 p-2 rounded w-40 font-black text-indigo-700 outline-none focus:border-indigo-400" value={range.from} onChange={e => setRange({...range, from: e.target.value})} />
        </div>
        <div className="space-y-1">
          <label className="font-black text-gray-400 uppercase text-[9px]">End Lot No</label>
          <input className="border-2 border-slate-100 p-2 rounded w-40 font-black text-indigo-700 outline-none focus:border-indigo-400" value={range.to} onChange={e => setRange({...range, to: e.target.value})} />
        </div>
        <button onClick={handleSearch} disabled={loading} className="bg-indigo-600 text-white px-10 py-2.5 rounded font-black uppercase hover:bg-indigo-800 transition-all shadow-md active:scale-95 flex items-center gap-2">
          {loading ? <Loader2 className="animate-spin" size={16}/> : <Search size={16}/>} RETRIEVE REGISTRY
        </button>
      </div>

      {/* THE GIANT GRID (20 Columns) */}
      <div className="bg-white border-2 border-slate-100 rounded-lg shadow-2xl overflow-x-auto max-h-[600px] scrollbar-hide">
        <table className="w-full border-collapse text-left min-w-[2400px]">
          <thead className="bg-[#b4b6e4] text-slate-800 uppercase font-black text-[9px] sticky top-0 z-20 shadow-md">
            <tr>
              <th className="p-3 border-r border-slate-300 sticky left-0 bg-[#b4b6e4] z-30">Lot No</th>
              <th className="p-3 border-r border-slate-300">Slip No</th>
              <th className="p-3 border-r border-slate-300">Rec Date</th>
              <th className="p-3 border-r border-slate-300">Merchant Name</th>
              <th className="p-3 border-r border-slate-300">Item Name</th>
              <th className="p-3 border-r border-slate-300 text-center">Item Qty</th>
              <th className="p-3 border-r border-slate-300">Unit Type</th>
              <th className="p-3 border-r border-slate-300 text-center text-red-600">Live Bal</th>
              <th className="p-3 border-r border-slate-300 w-24 text-center bg-indigo-50">Unit Wgt</th>
              <th className="p-3 border-r border-slate-300 text-center">In-Rate</th>
              <th className="p-3 border-r border-slate-300 text-center">In-Labour</th>
              <th className="p-3 border-r border-slate-300 w-48 bg-yellow-50 text-indigo-900">Assign Chamber</th>
              <th className="p-3 border-r border-slate-300 w-20 text-center">Floor</th>
              <th className="p-3 border-r border-slate-300 w-20 text-center">Pole</th>
              <th className="p-3 border-r border-slate-300 w-32 text-center">Lot Value</th>
              <th className="p-3 border-r border-slate-300 w-32">Marka</th>
              <th className="p-3 border-r border-slate-300 w-32">PMarka</th>
              <th className="p-3 border-r border-slate-300 w-48">Audit Remarks</th>
              <th className="p-3 border-r border-slate-300 w-32">Variety</th>
              <th className="p-3">Upto Date</th>
            </tr>
          </thead>
          <tbody>
            {loading ? (
              <tr><td colSpan={20} className="p-24 text-center font-black text-indigo-700 animate-pulse text-lg uppercase">Compiling Warehouse Registry Data...</td></tr>
            ) : records.length === 0 ? (
              <tr><td colSpan={20} className="p-24 text-center text-gray-300 italic font-medium uppercase tracking-[5px]">Define lot range to begin bulk attribute correction</td></tr>
            ) : records.map((row) => (
              <tr key={row.id} className={`border-b transition-all ${modifiedIds.has(row.id) ? 'bg-indigo-50/50 shadow-inner' : 'hover:bg-slate-50'}`}>
                <td className="p-3 border-r border-slate-200 sticky left-0 bg-white z-10 font-black text-indigo-800 text-xs shadow-sm">{row.lotNo}</td>
                <td className="p-3 border-r border-slate-100 text-gray-400 font-mono">{row.mrNo}</td>
                <td className="p-3 border-r border-slate-100 text-gray-500">{formatDate(row.arrivalDate)}</td>
                <td className="p-3 border-r border-slate-100 uppercase font-black text-slate-600 truncate max-w-[150px]">{row.party.tradeName}</td>
                <td className="p-3 border-r border-slate-100 uppercase font-medium text-slate-600">{row.item.name}</td>
                <td className="p-3 border-r border-slate-100 text-center font-bold">{row.receivedQty}</td>
                <td className="p-3 border-r border-slate-100 text-gray-400">{row.unit.name}</td>
                <td className="p-3 border-r border-slate-100 text-center font-black text-red-600 bg-red-50/20">{row.balanceQty}</td>
                
                {/* EDITABLE FIELDS START */}
                <td className="p-1 border-r border-slate-200 bg-indigo-50/20">
                  <input type="number" className="w-full p-2 border-none text-center font-black text-blue-600 bg-transparent outline-none focus:ring-1 focus:ring-blue-400" 
                    value={editState[row.id]?.perUnitWgt} 
                    onChange={e => handleInputChange(row.id, "perUnitWgt", e.target.value)} 
                  />
                </td>
                <td className="p-3 border-r border-slate-100 text-center text-gray-300 italic">{row.rate}</td>
                <td className="p-3 border-r border-slate-100 text-center text-gray-300 italic">{row.labour}</td>
                
                <td className="p-1 border-r border-slate-200 bg-yellow-50/30">
                  <select className="w-full p-2 border-none font-bold text-indigo-700 bg-transparent outline-none" 
                    value={editState[row.id]?.chamberId} 
                    onChange={e => handleInputChange(row.id, "chamberId", e.target.value)}
                  >
                    {chambers.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}
                  </select>
                </td>
                <td className="p-1 border-r border-slate-200">
                  <input className="w-full p-2 border-none text-center font-bold bg-transparent outline-none" 
                    value={editState[row.id]?.floor || ""} 
                    onChange={e => handleInputChange(row.id, "floor", e.target.value)} 
                  />
                </td>
                <td className="p-1 border-r border-slate-200">
                  <input className="w-full p-2 border-none text-center font-bold bg-transparent outline-none" 
                    value={editState[row.id]?.pole || ""} 
                    onChange={e => handleInputChange(row.id, "pole", e.target.value)} 
                  />
                </td>
                <td className="p-1 border-r border-slate-200">
                   <input type="number" className="w-full p-2 border-none text-center font-bold bg-transparent outline-none" 
                    value={editState[row.id]?.lotValue} 
                    onChange={e => handleInputChange(row.id, "lotValue", e.target.value)} 
                   />
                </td>
                <td className="p-1 border-r border-slate-200">
                  <input className="w-full p-2 border-none uppercase font-black text-indigo-600 bg-transparent outline-none" 
                    value={editState[row.id]?.marka || ""} 
                    onChange={e => handleInputChange(row.id, "marka", e.target.value.toUpperCase())} 
                  />
                </td>
                <td className="p-1 border-r border-slate-200">
                  <input className="w-full p-2 border-none uppercase font-bold text-gray-500 bg-transparent outline-none" 
                    value={editState[row.id]?.pMarka || ""} 
                    onChange={e => handleInputChange(row.id, "pMarka", e.target.value.toUpperCase())} 
                  />
                </td>
                <td className="p-1 border-r border-slate-200">
                  <input className="w-full p-2 border-none italic bg-transparent outline-none" 
                    value={editState[row.id]?.remarks || ""} 
                    onChange={e => handleInputChange(row.id, "remarks", e.target.value)} 
                  />
                </td>
                <td className="p-1 border-r border-slate-200">
                  <input className="w-full p-2 border-none font-bold text-slate-600 bg-transparent outline-none" 
                    value={editState[row.id]?.variety || ""} 
                    onChange={e => handleInputChange(row.id, "variety", e.target.value)} 
