<file path="app/inward/update/page.tsx">
"use client";

import React, { useState, useCallback } from "react";
import { Search, Edit3, Save, ArrowLeft, RefreshCcw, X, Loader2, CheckCircle2 } from "lucide-react";
import { toast } from "react-hot-toast";
import { formatDate } from "@/lib/utils";
import { useRouter } from "next/navigation";

export default function UpdateMRDetailsPage() {
  const router = useRouter();
  const [range, setRange] = useState({ from: "", to: "" });
  const [records, setRecords] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [isSavingAll, setIsSavingAll] = useState(false);
  
  // Track which rows are being edited and their data
  const [editingRow, setEditingRow] = useState<string | null>(null);
  const [editState, setEditState] = useState<Record<string, any>>({});

  // 1. SEARCH FUNCTION
  const handleSearch = async () => {
    if (!range.from || !range.to) return toast.error("Bhai, Slip range toh daalo!");
    setLoading(true);
    try {
      const res = await fetch(`/api/inward/update-mr?fromSlip=${range.from}&toSlip=${range.to}`);
      const json = await res.json();
      if (res.ok) {
        setRecords(json);
        // Initialize edit state for all records
        const initialEditState: any = {};
        json.forEach((r: any) => {
          initialEditState[r.id] = { ...r };
        });
        setEditState(initialEditState);
        
        if (json.length === 0) toast.error("Is range mein koi MR nahi mili!");
      }
    } catch (err) {
      toast.error("Search fail ho gaya!");
    } finally {
      setLoading(false);
    }
  };

  // 2. INDIVIDUAL ROW UPDATE
  const handleSingleUpdate = async (id: string) => {
    const loadId = toast.loading("Updating record...");
    try {
      const res = await fetch(`/api/inward/update-mr`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(editState[id]),
      });
      if (res.ok) {
        toast.success("MR Details updated!", { id: loadId });
        setEditingRow(null);
        handleSearch(); 
      } else {
        toast.error("Update failed", { id: loadId });
      }
    } catch (err) {
      toast.error("Network error!", { id: loadId });
    }
  };

  // 3. BULK UPDATE ALL (Zaroori logic)
  const handleUpdateAll = async () => {
    if (records.length === 0) return;
    setIsSavingAll(true);
    const loadId = toast.loading("Synchronizing all changes...");
    
    try {
      // Mapping all changes to a bulk request
      const updates = records.map(r => editState[r.id]);
      
      // Note: Backend should support bulk update or we loop
      // Assuming backend PATCH handles this if we implement bulk logic
      const results = await Promise.all(updates.map(u => 
        fetch(`/api/inward/update-mr`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(u),
        })
      ));

      if (results.every(r => r.ok)) {
        toast.success("All records updated successfully!", { id: loadId });
        setEditingRow(null);
        handleSearch();
      } else {
        toast.error("Some records failed to update", { id: loadId });
      }
    } catch (err) {
      toast.error("Bulk update failed", { id: loadId });
    } finally {
      setIsSavingAll(false);
    }
  };

  const onInputChange = (id: string, field: string, value: any) => {
    setEditState(prev => ({
      ...prev,
      [id]: { ...prev[id], [field]: value }
    }));
  };

  return (
    <div className="space-y-4 text-[11px] animate-in fade-in duration-500">
      
      {/* Visual Header */}
      <div className="bg-[#5d5fb1] text-white p-3 rounded-t-lg flex justify-between items-center shadow-md">
        <h2 className="font-bold uppercase flex items-center gap-2 tracking-widest">
          <RefreshCcw size={16}/> MINOR CHANGES INWARD ENTRY (MR LOGS)
        </h2>
        <div className="flex gap-2">
            <button 
                onClick={handleUpdateAll}
                disabled={isSavingAll || records.length === 0}
                className="bg-red-600 hover:bg-red-700 px-6 py-1 rounded font-black flex items-center gap-2 uppercase transition-all shadow-lg active:scale-95 disabled:opacity-50"
            >
            {isSavingAll ? <Loader2 size={14} className="animate-spin"/> : <CheckCircle2 size={14}/>} 
            UPDATE ALL RECORDS
            </button>
        </div>
      </div>

      {/* SEARCH BOX (Exact mapping to Image 84) */}
      <div className="bg-white p-6 border rounded shadow-sm flex items-end gap-6">
        <div className="space-y-1">
          <label className="font-bold text-gray-400 uppercase block tracking-widest">From Slip No</label>
          <input 
            className="border-2 border-slate-100 p-2 rounded w-44 outline-none focus:border-indigo-500 font-black text-indigo-700 shadow-inner" 
            value={range.from} 
            onChange={e => setRange({...range, from: e.target.value})} 
            placeholder="Start Range"
          />
        </div>
        <div className="space-y-1">
          <label className="font-bold text-gray-400 uppercase block tracking-widest">To Slip No</label>
          <input 
            className="border-2 border-slate-100 p-2 rounded w-44 outline-none focus:border-indigo-500 font-black text-indigo-700 shadow-inner" 
            value={range.to} 
            onChange={e => setRange({...range, to: e.target.value})} 
            placeholder="End Range"
          />
        </div>
        <button 
          onClick={handleSearch}
          disabled={loading}
          className="bg-indigo-600 text-white px-10 py-2.5 rounded font-black uppercase hover:bg-indigo-700 flex items-center gap-2 shadow-lg transition-all active:scale-95 disabled:opacity-50"
        >
          {loading ? <Loader2 className="animate-spin" size={16}/> : <Search size={16}/>} Search MR Logs
        </button>
      </div>

      {/* DATA GRID */}
      <div className="bg-white border rounded shadow-xl overflow-x-auto min-h-[400px]">
        <table className="w-full border-collapse text-left">
          <thead className="bg-[#b4b6e4] text-slate-800 uppercase font-black text-[9px] sticky top-0 z-10 shadow-sm">
            <tr>
              <th className="p-3 border-r border-slate-300">Slip No</th>
              <th className="p-3 border-r border-slate-300">MR Date</th>
              <th className="p-3 border-r border-slate-300">Party / Merchant Name</th>
              <th className="p-3 border-r border-slate-300">Billing Type</th>
              <th className="p-3 border-r border-slate-300">Truck/Veh No.</th>
              <th className="p-3 border-r border-slate-300">Delivery Person</th>
              <th className="p-3 border-r border-slate-300">Special Remarks</th>
              <th className="p-3 text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            {records.length === 0 ? (
              <tr><td colSpan={8} className="p-24 text-center text-gray-300 italic font-medium uppercase tracking-[5px]">Enter slip range to begin editing</td></tr>
            ) : records.map((row) => (
              <tr key={row.id} className={`border-b transition-all ${editingRow === row.id ? 'bg-indigo-50/50' : 'hover:bg-slate-50'}`}>
                <td className="p-3 border-r border-slate-200 font-black text-indigo-800 text-sm">{row.lot.mrNo}</td>
                
                {/* MR DATE EDIT */}
                <td className="p-2 border-r border-slate-200">
                  {editingRow === row.id ? (
                    <input type="date" className="w-full border p-1 rounded font-bold outline-none focus:ring-1 focus:ring-indigo-400" value={editState[row.id].mrDate?.split('T')[0]} onChange={e => onInputChange(row.id, "mrDate", e.target.value)} />
                  ) : <span className="font-mono text-gray-500">{formatDate(row.mrDate)}</span>}
                </td>

                <td className="p-3 border-r border-slate-200 font-bold uppercase text-slate-700 truncate max-w-[200px]">{row.lot.party.tradeName}</td>

                {/* BILLING TYPE EDIT */}
                <td className="p-2 border-r border-slate-200">
                  {editingRow === row.id ? (
                    <select className="w-full border p-1 rounded font-bold bg-white outline-none focus:ring-1 focus:ring-indigo-400" value={editState[row.id].billingType} onChange={e => onInputChange(row.id, "billingType", e.target.value)}>
                      <option value="NA">NA</option>
                      <option value="Weekly">Weekly</option>
                      <option value="Monthly">Monthly</option>
                      <option value="Nill Lot">Nill Lot</option>
                    </select>
                  ) : <span className="bg-blue-100 text-blue-700 px-2 py-0.5 rounded text-[8px] font-black uppercase">{row.billingType}</span>}
                </td>

                {/* TRUCK NO EDIT */}
                <td className="p-2 border-r border-slate-200">
                  {editingRow === row.id ? (
                    <input className="w-full border p-1 rounded font-mono uppercase font-bold outline-none focus:ring-1 focus:ring-indigo-400" value={editState[row.id].truckNo} onChange={e => onInputChange(row.id, "truckNo", e.target.value)} />
                  ) : <span className="font-mono font-bold text-slate-600">{row.truckNo || "---"}</span>}
                </td>

                {/* PERSON EDIT */}
                <td className="p-2 border-r border-slate-200">
                  {editingRow === row.id ? (
                    <input className="w-full border p-1 rounded font-bold outline-none focus:ring-1 focus:ring-indigo-400" value={editState[row.id].deliveryPerson} onChange={e => onInputChange(row.id, "deliveryPerson", e.target.value)} />
                  ) : <span className="text-slate-500">{row.deliveryPerson || "---"}</span>}
                </td>

                {/* REMARKS EDIT */}
                <td className="p-2 border-r border-slate-200">
                  {editingRow === row.id ? (
                    <input className="w-full border p-1 rounded italic outline-none focus:ring-1 focus:ring-indigo-400" value={editState[row.id].remarks || ""} onChange={e => onInputChange(row.id, "remarks", e.target.value)} />
                  ) : <span className="text-gray-400 italic truncate max-w-[150px] inline-block">{row.remarks || "No remarks"}</span>}
                </td>

                {/* ACTIONS */}
                <td className="p-2 text-center">
                  {editingRow === row.id ? (
                    <div className="flex gap-2 justify-center">
                      <button onClick={() => handleSingleUpdate(row.id)} className="bg-green-600 text-white p-1.5 rounded shadow hover:bg-green-700 transition-all"><Save size={14}/></button>
                      <button onClick={() => setEditingRow(null)} className="bg-red-500 text-white p-1.5 rounded shadow hover:bg-red-600 transition-all"><X size={14}/></button>
                    </div>
                  ) : (
                    <button 
                      onClick={() => setEditingRow(row.id)}
                      className="text-blue-600 hover:scale-125 transition-all p-1 bg-blue-50 rounded"
                    >
                      <Edit3 size={16}/>
                    </button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* Footer Disclaimer */}
      <div className="p-2 opacity-50 flex justify-between items-center px-4">
         <p className="italic">Note: Major changes like Item Name or Quantity require a reversal entry for audit safety.</p>
         <p className="font-bold">Cold Storage ERP v1.0</p>
      </div>
    </div>
  );
}
</file>

