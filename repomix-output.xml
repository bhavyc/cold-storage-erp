import { NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";
import { Prisma } from "@prisma/client";
import { InvoiceSchema } from "@/lib/validations/billing";
import { getNextNumber } from "@/lib/sequence-engine"; // Import Engine
 

export async function POST(req: Request) {
  try {
    const body = await req.json();
    const { header, items, totals } = body;

    // 1. Transform data for Zod validation
    const dataToValidate = {
      partyId: header.partyId,
      invoiceDate: header.billDate, 
      billingType: "Nill Lot",      
      isProforma: false,
      totalQty: Number(totals.totalQty),
      totalRent: Number(totals.rentTotal),
      totalLabour: Number(totals.labourTotal),
      taxableValue: Number(totals.taxableValue),
      cgst: Number(totals.cgstAmt),
      sgst: Number(totals.sgstAmt),
      igst: Number(totals.igstAmt),
      roundOff: Number(totals.roundOff),
      netAmount: Number(totals.netAmt),
      items: items.map((it: any) => ({
        lotId: it.lotId,
        qty: Number(it.qty),
        period: Number(it.prd),
        rentRate: Number(it.rentRate),
        labourRate: Number(it.labRate),
        rentAmt: Number(it.rentAmt),
        labourAmt: Number(it.labourAmt),
      }))
    };

    // 2. Validate
    const parsedData = InvoiceSchema.parse(dataToValidate);

    // 3. Process Transaction
    const invoiceResult = await prisma.$transaction(async (tx) => {
      
      const autoInvoiceNo = await getNextNumber("INV", tx);

      const invoice = await tx.invoice.create({
        data: {
          invoiceNo: autoInvoiceNo,
          date: new Date(parsedData.invoiceDate),
          partyId: parsedData.partyId,
          billingType: parsedData.billingType,
          totalQty: parsedData.totalQty,
          totalRent: new Prisma.Decimal(parsedData.totalRent),
          totalLabour: new Prisma.Decimal(parsedData.totalLabour),
          taxableValue: new Prisma.Decimal(parsedData.taxableValue),
          cgst: new Prisma.Decimal(parsedData.cgst),
          sgst: new Prisma.Decimal(parsedData.sgst),
          igst: new Prisma.Decimal(parsedData.igst),
          roundOff: new Prisma.Decimal(parsedData.roundOff),
          netAmount: new Prisma.Decimal(parsedData.netAmount),
          status: "Unpaid",
          items: {
            create: parsedData.items.map((it: any) => ({
              lotId: it.lotId,
              qty: it.qty,
              period: it.period,
              rentRate: new Prisma.Decimal(it.rentRate),
              labourRate: new Prisma.Decimal(it.labourRate),
              rentAmt: new Prisma.Decimal(it.rentAmt),
              labourAmt: new Prisma.Decimal(it.labourAmt),
            }))
          }
        }
      });

      for (const it of parsedData.items) {
        await tx.lot.update({
          where: { id: it.lotId },
          data: { uptoDate: new Date(parsedData.invoiceDate) }
        });
      }

      return invoice;
    }, {
      isolationLevel: Prisma.TransactionIsolationLevel.Serializable
    });

    // ✅ FIX: Hamesha NextResponse.json return karein
    return NextResponse.json(invoiceResult);

  } catch (error: any) {
    console.error("INVOICE_POST_ERR:", error);
    if (error.name === "ZodError") {
      return NextResponse.json({ error: "Validation Error: Kripya data check karein." }, { status: 400 });
    }
    return NextResponse.json({ error: error.message || "Internal Server Error" }, { status: 500 });
  }
}

