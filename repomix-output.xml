import { NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";

export async function GET(req: Request) {
  try {
    const { searchParams } = new URL(req.url);
    const partyId = searchParams.get("partyId");

    if (!partyId || partyId === "undefined") {
      return NextResponse.json({ error: "Party ID missing" }, { status: 400 });
    }

    // 1. Lots fetch karo (Corrected field name to demandItems)
    const lots = await prisma.lot.findMany({
      where: { 
        partyId: partyId,
        balanceQty: { gt: 0 } 
      },
      include: { 
        item: true, 
        unit: true, 
        chamber: true,
        demandItems: { // <--- demands ki jagah demandItems kar diya
          include: {
            demand: true 
          }
        }
      }
    });

    // 2. Logic to calculate available balance
    const result = lots.map((lot: any) => {
      // Yahan bhi lot.demands ki jagah lot.demandItems use hoga
      const totalBlocked = (lot.demandItems || [])
        .filter((d: any) => d.demand?.status === "Pending")
        .reduce((sum: number, d: any) => sum + (Number(d.qty) || 0), 0);
      
      const available = lot.balanceQty - totalBlocked;

      return {
        ...lot,
        originalBal: lot.balanceQty,
        availableQty: available > 0 ? available : 0,
        item: lot.item,
        unit: lot.unit,
        chamber: lot.chamber
      };
    });

    return NextResponse.json(result.filter(l => l.availableQty > 0));

  } catch (error: any) {
    console.error("DEMAND_GET_ERROR:", error);
    return NextResponse.json({ error: "Server Error: " + error.message }, { status: 500 });
  }
}

// 2. POST: Save Demand Entry
export async function POST(req: Request) {
  try {
    const body = await req.json();
    const { header, items } = body;

    const result = await prisma.$transaction(async (tx) => {
      // Create Demand Header
      const demand = await tx.demand.create({
        data: {
          demandNo: header.demandNo,
          date: new Date(header.demandDate),
          partyId: header.partyId,
          status: "Pending",
          items: {
            create: items.map((it: any) => ({
              lotId: it.lotId,
              qty: it.demandQty
            }))
          }
        }
      });
      return demand;
    });

    return NextResponse.json(result, { status: 201 });
  } catch (error) {
    return NextResponse.json({ error: "Failed to save demand" }, { status: 400 });
  }
}
