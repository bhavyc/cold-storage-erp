import { NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";
import {Prisma} from "@prisma/client";

export async function GET() {
  try {
    const parties = await prisma.party.findMany({
      include: {
        lots: true,
        invoices: true,
      }
    });

    const report = parties.map(party => {
      // 1. Total Stock Qty Inwarded
      const totalInQty = party.lots.reduce((sum, lot) => sum + lot.receivedQty, 0);
      
      // 2. Total Qty Billed (from Invoices)
      const totalBilledQty = party.invoices.reduce((sum, inv) => sum + inv.totalQty, 0);

      // 3. Difference Logic
      const diff = totalInQty - totalBilledQty;

      return {
        partyName: party.tradeName,
        partyCode: party.partyCode,
        totalInQty,
        totalBilledQty,
        difference: diff,
        status: diff === 0 ? "Matched" : "Mismatch"
      };
    });

    // Filter only mismatches if required (Image 72 logic)
    return NextResponse.json(report.filter(r => r.difference !== 0));
  } catch (error) {
    return NextResponse.json({ error: "Audit failed" }, { status: 500 });
  }
}
