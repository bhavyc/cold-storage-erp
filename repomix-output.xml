                    {row.assignedQty}
                  </td>
                  <td className="p-4 text-center font-mono text-gray-500">
                     {formatDate(row.date)}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}
</file>

<file path="app/location/pending-allocation/page.tsx">
"use client";

import React, { useState, useEffect, useMemo, useCallback } from "react";
import { Search, Printer, FileSpreadsheet, Loader2, AlertCircle, PackageSearch, LayoutGrid, ArrowRight } from "lucide-react";
import { toast } from "react-hot-toast";
import { useRouter } from "next/navigation";

export default function PendingAllocationReport() {
  const router = useRouter();
  const [data, setData] = useState<any[]>([]);
  const [parties, setParties] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  
  // 1. UPDATED FILTER STATES (Including Smart Search)
  const [filters, setFilters] = useState({
    fromLot: "",
    toLot: "",
    partyId: "All",
    query: "" // ✅ Smart Search Input
  });

  // Load Parties for dropdown
  useEffect(() => {
    fetch("/api/masters/party")
      .then(res => res.json())
      .then(json => setParties(json || []))
      .catch(() => toast.error("Parties load nahi ho payi!"));
  }, []);

  // 2. SEARCH LOGIC (Hits /api/reports/pending-allocation)
  const handleSearch = useCallback(async () => {
    setLoading(true);
    try {
      const queryParams = new URLSearchParams(filters as any).toString();
      const res = await fetch(`/api/reports/pending-allocation?${queryParams}`);
      if (!res.ok) throw new Error("Fetch error");
      const json = await res.json();
      
      setData(json);
      if (json.length === 0) {
        toast.success("Sab kuch allocated hai! No pending stock.");
      } else {
        toast.success(`${json.length} items waiting for allocation.`);
      }
    } catch (err) {
      toast.error("Data load karne mein error!");
    } finally {
      setLoading(false);
    }
  }, [filters]);

  // 3. LIVE TOTAL CALCULATION (Grand sum of pending bags)
  const grandTotalPending = useMemo(() => {
    return data.reduce((sum, row) => sum + (Number(row.pendingQty) || 0), 0);
  }, [data]);

  return (
    <div className="space-y-4 text-[10px] animate-in fade-in duration-500">
      
      {/* Visual Header */}
      <div className="bg-[#4a4ea3] text-white p-3 rounded-t-lg shadow-lg flex justify-between items-center no-print">
        <h2 className="font-bold uppercase flex items-center gap-2 tracking-[3px] text-xs">
          <LayoutGrid size={18}/> Pending Pallet Allocation Report
        </h2>
        <div className="bg-white/20 px-4 py-1 rounded-full text-[9px] font-black italic uppercase">
           Internal Stock Audit
        </div>
      </div>

      {/* SMART FILTER BAR (Replicating Image 34 + Enhancements) */}
      <div className="bg-white border-2 border-indigo-50 rounded-xl p-6 shadow-sm flex flex-wrap gap-6 items-end no-print">
        <div className="space-y-1">
          <label className="font-black text-slate-500 uppercase tracking-tighter text-[9px]">Lot Range (Optional)</label>
          <div className="flex gap-2">
            <input className="border-2 border-slate-100 p-2 rounded-md w-24 outline-none focus:border-orange-400 font-bold shadow-inner" placeholder="From No" value={filters.fromLot} onChange={e => setFilters({...filters, fromLot: e.target.value})} />
            <input className="border-2 border-slate-100 p-2 rounded-md w-24 outline-none focus:border-orange-400 font-bold shadow-inner" placeholder="To No" value={filters.toLot} onChange={e => setFilters({...filters, toLot: e.target.value})} />
          </div>
        </div>

        <div className="space-y-1">
          <label className="font-black text-slate-500 uppercase tracking-tighter text-[9px]">Filter By Party</label>
          <select 
            className="border-2 border-slate-100 p-2 rounded-md w-52 bg-white font-bold text-slate-700 outline-none focus:border-orange-400"
            value={filters.partyId}
            onChange={e => setFilters({...filters, partyId: e.target.value})}
          >
            <option value="All">--- ALL PARTIES ---</option>
            {parties.map(p => <option key={p.id} value={p.id}>{p.tradeName}</option>)}
          </select>
        </div>

        <div className="space-y-1">
          <label className="font-black text-indigo-700 uppercase tracking-tighter text-[9px]">Smart Search (Merchant / Marka / Item)</label>
          <div className="relative">
            <PackageSearch className="absolute left-3 top-2.5 text-indigo-300" size={14} />
            <input 
              className="border-2 border-indigo-100 p-2 pl-10 rounded-md w-72 outline-none focus:border-indigo-500 font-black uppercase shadow-sm" 
              placeholder="Type name or marka..." 
              value={filters.query}
              onChange={e => setFilters({...filters, query: e.target.value})}
              onKeyDown={(e) => e.key === 'Enter' && handleSearch()}
            />
          </div>
        </div>

        <div className="flex gap-2">
          <button 
            onClick={handleSearch}
            disabled={loading}
            className="bg-orange-500 hover:bg-orange-600 text-white px-10 py-2 rounded-md font-black uppercase flex items-center gap-2 shadow-lg transition-all active:scale-95 disabled:opacity-50"
          >
            {loading ? <Loader2 className="animate-spin" size={14}/> : <Search size={16}/>}
            SEARCH PENDING
          </button>
          <button onClick={() => window.print()} className="bg-red-500 text-white p-2 rounded-md shadow hover:bg-red-600 transition-colors"><Printer size={16}/></button>
          <button className="bg-green-600 text-white p-2 rounded-md shadow hover:bg-green-700 transition-colors"><FileSpreadsheet size={16}/></button>
        </div>
      </div>

      {/* GRAND TOTAL PENDING BADGE */}
      <div className="text-center py-2 animate-bounce hover:pause">
        <p className="bg-red-600 text-white inline-block px-16 py-2.5 rounded-full font-black text-xs shadow-2xl uppercase tracking-[3px] border-4 border-white">
          Total Unallocated Bags Found = <span className="text-yellow-300 text-lg ml-2">{grandTotalPending.toLocaleString()}</span>
        </p>
      </div>

      {/* DATA TABLE (Image 34 Columns Mapping) */}
      <div className="bg-white border-2 border-slate-100 rounded-lg shadow-2xl overflow-hidden min-h-[450px]">
        <div className="bg-indigo-50/50 p-2 text-center font-black text-indigo-800 border-b italic uppercase tracking-widest flex items-center justify-center gap-2">
          <AlertCircle size={14}/> Critical Audit: Lots waiting for Pallet / Bin assignment
        </div>
        
        <div className="overflow-x-auto">
          <table className="w-full text-left border-collapse min-w-[1400px]">
            <thead className="bg-[#b4b6e4] text-slate-800 uppercase font-black text-[9px] sticky top-0 shadow-sm z-10">
              <tr>
                <th className="p-4 border-r border-indigo-200 w-16 text-center">SR.</th>
                <th className="p-4 border-r border-indigo-200">PARTY CODE</th>
                <th className="p-4 border-r border-indigo-200">MERCHANT / PARTY NAME</th>
                <th className="p-4 border-r border-indigo-200">LOT NO</th>
                <th className="p-4 border-r border-indigo-200">ITEM CODE</th>
                <th className="p-4 border-r border-indigo-200">ITEM NAME</th>
                <th className="p-4 border-r border-indigo-200">PACKING</th>
                <th className="p-4 border-r border-indigo-200 text-center">REC. QTY</th>
                <th className="p-4 border-r border-indigo-200 text-center text-blue-700">ALLOCATED</th>
                <th className="p-4 border-r border-indigo-200 text-center font-black text-red-600 bg-red-50">PENDING QTY</th>
                <th className="p-4 text-center no-print">ACTION</th>
              </tr>
            </thead>
            <tbody>
              {loading ? (
                <tr><td colSpan={11} className="p-24 text-center font-bold text-indigo-700 animate-pulse text-lg uppercase tracking-widest">Scanning internal warehouse storage...</td></tr>
              ) : data.length === 0 ? (
                <tr>
                  <td colSpan={11} className="p-24 text-center text-gray-400 italic font-medium">
                    <div className="flex flex-col items-center gap-3 opacity-40">
                       <AlertCircle size={48}/>
                       <p className="text-sm uppercase font-black tracking-widest">No Pending Stock Found</p>
                       <p className="text-[10px]">All inward lots are successfully assigned to pallets.</p>
                    </div>
                  </td>
                </tr>
              ) : (
                data.map((row, idx) => (
                  <tr key={row.lotNo} className="border-b hover:bg-indigo-50/50 transition-all font-bold group even:bg-slate-50/30">
                    <td className="p-4 border-r border-slate-100 text-center text-gray-400 font-mono">{idx + 1}</td>
                    <td className="p-4 border-r border-slate-100 font-mono text-indigo-700">{row.partyCode}</td>
                    <td className="p-4 border-r border-slate-100 uppercase truncate max-w-[200px] text-slate-800">{row.partyName}</td>
                    <td className="p-4 border-r border-slate-100 font-black text-blue-800">{row.lotNo}</td>
                    <td className="p-4 border-r border-slate-100 text-gray-500 font-mono">{row.itemCode}</td>
                    <td className="p-4 border-r border-slate-100 uppercase text-slate-700">{row.itemName}</td>
                    <td className="p-4 border-r border-slate-100 text-gray-400">{row.unitName}</td>
                    <td className="p-4 border-r border-slate-100 text-center text-slate-800 font-black">{row.receivedQty}</td>
                    <td className="p-4 border-r border-slate-100 text-center text-blue-600 bg-blue-50/20">{row.allocatedQty}</td>
                    <td className="p-4 border-r border-slate-100 text-center font-black text-red-600 bg-red-100/50 animate-pulse text-sm">
                      {row.pendingQty}
                    </td>
                    <td className="p-4 text-center no-print">
                       <button 
                         onClick={() => router.push(`/location/assign-pallet?lotNo=${row.lotNo}`)}
                         className="bg-indigo-600 hover:bg-indigo-800 text-white px-5 py-1.5 rounded-full text-[9px] font-black uppercase tracking-tighter flex items-center gap-1 mx-auto shadow-md transition-all active:scale-90"
                       >
                         Assign Now <ArrowRight size={12}/>
                       </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>

      {/* Footer Audit Hint */}
      <div className="flex justify-between items-center bg-[#f8f9fa] p-3 border rounded shadow-inner opacity-60 no-print">
         <p className="font-bold uppercase tracking-widest text-[9px] flex items-center gap-2">
           <AlertCircle size={14}/> Records: {data.length} | Aggregate Balance: {grandTotalPending} Bags
         </p>
         <p className="text-[8px] font-black italic uppercase tracking-[10px]">Cold Storage Intelligence System</p>
      </div>
    </div>
  );
}
