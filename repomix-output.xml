<file path="app/billing/entry/page.tsx">
"use client";

import React, { useState, useEffect, useMemo, useCallback } from "react";
import { Save, Printer, Import, FileText, X, RotateCcw, Loader2, Calendar, Calculator, Landmark, Tag, AlertCircle, ArrowRight } from "lucide-react";
import { toast } from "react-hot-toast";
import { useRouter } from "next/navigation";
import { formatDate } from "@/lib/utils";

export default function BillEntryPage() {
  const router = useRouter();
  const [parties, setParties] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [isSaving, setIsSaving] = useState(false);
  
  // 1. HEADER STATE
  const [header, setHeader] = useState({
    invoiceNo: "", 
    billDate: new Date().toISOString().split('T')[0],
    partyId: "", 
    gstType: "NA", 
    stateName: "NA", 
    stateCode: "06",
    partyGst: "NA", 
    graceDays: 0,
    gstOn: "GST On Both (Labour + Rent)"
  });

  // 2. GRID & TAX STATE
  const [items, setItems] = useState<any[]>([]);
  const [discount, setDiscount] = useState<number>(0);
  const [taxRates, setTaxRates] = useState({ cgst: 9, sgst: 9, igst: 0 });

  // Load Initial Data
  useEffect(() => {
    fetch("/api/masters/party").then(res => res.json()).then(setParties);
    fetch("/api/billing/invoice/next-no").then(res => res.json()).then(d => setHeader(h => ({...h, invoiceNo: d.nextNo})));
  }, []);

  // 3. AUTOMATION: Party Selection logic
  const handlePartyChange = (id: string) => {
    const p = parties.find(x => x.id === id);
    if (p) {
      setHeader({
        ...header, 
        partyId: id, 
        partyGst: p.gstNo || "UNREGISTERED", 
        stateName: p.stateName || "NA", 
        stateCode: p.stateCode || "06",
        graceDays: p.graceDays || 0,
        gstType: p.gstType || "NA"
      });

      if (p.stateCode === "06") {
        setTaxRates({ cgst: 9, sgst: 9, igst: 0 });
      } else {
        setTaxRates({ cgst: 0, sgst: 0, igst: 18 });
      }
      toast.success(`Merchant ${p.tradeName} selected`);
    }
  };

  // 4. LIVE MATH ENGINE (Calculates everything on the fly)
  const calculatedData = useMemo(() => {
    let totalRent = 0;
    let totalLab = 0;
    let totalQty = 0;

    const processedItems = items.map(it => {
      const qty = Number(it.qty) || 0;
      const rent = Number(it.rentRate) || 0;
      const lab = Number(it.labRate) || 0;
      const prd = Number(it.prd) || 0;

      const rentAmt = qty * rent * prd;
      const labAmt = qty * lab;
      
      totalRent += rentAmt;
      totalLab += labAmt;
      totalQty += qty;

      return { ...it, rentAmt, labourAmt: labAmt, prd, rentRate: rent, labRate: lab };
    });

    const grossAmount = totalRent + totalLab;
    const taxableValue = Math.max(0, grossAmount - Number(discount));
    
    const cgstAmt = taxableValue * (taxRates.cgst / 100);
    const sgstAmt = taxableValue * (taxRates.sgst / 100);
    const igstAmt = taxableValue * (taxRates.igst / 100);
    
    const netAmt = Math.round(taxableValue + cgstAmt + sgstAmt + igstAmt);
    const roundOff = netAmt - (taxableValue + cgstAmt + sgstAmt + igstAmt);

    return {
      processedItems,
      totals: {
        totalQty, grossAmount, taxableValue, cgstAmt, sgstAmt, igstAmt, 
        labourTotal: totalLab, rentTotal: totalRent, netAmt, roundOff
      }
    };
  }, [items, discount, taxRates]);

  // ==========================================
  // 🔴 RED BUTTONS LOGIC 🔴
  // ==========================================

  const handleImportData = async () => {
    if (!header.partyId) return toast.error("Merchant select karna mandatory hai!");
    setLoading(true);
    setItems([]); 
    try {
      const res = await fetch(`/api/billing/nill-lot-import?partyId=${header.partyId}`);
      const data = await res.json();
      if (!res.ok || data.length === 0) {
        toast.error("Is party ka koi unbilled dispatch nahi mila!");
      } else {
        setItems([...data]);
        toast.success(`${data.length} Unbilled lots imported.`);
      }
    } catch (err) {
      toast.error("Data load karne mein error!");
    } finally {
      setLoading(false);
    }
  };

  const calculatePeriod = () => {
    if (items.length === 0) return toast.error("Pehle Data Import karein!");
    const updated = items.map(it => {
      const start = it.uptoDate ? new Date(it.uptoDate) : new Date(it.mrDate);
      const end = new Date(header.billDate);
      const diff = Math.ceil((end.getTime() - start.getTime()) / (1000 * 60 * 60 * 24));
      const finalPrd = it.uptoDate ? Math.max(0, diff) : Math.max(0, diff - header.graceDays);
      return { ...it, prd: finalPrd };
    });
    setItems(updated);
    toast.success("Billing period (days) calculated!");
  };

  // 💾 FINAL SAVE
  const handleSave = async () => {
    if (items.length === 0) return toast.error("Bill khali hai!");
    setIsSaving(true);
    const loadId = toast.loading("Saving Tax Invoice...");
    try {
      const res = await fetch("/api/billing/invoice", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ 
          header, 
          items: calculatedData.processedItems, 
          totals: calculatedData.totals 
        })
      });
      const result = await res.json();
      if (res.ok) {
        toast.success(`Invoice Saved! Bill No: ${result.invoiceNo}`, { id: loadId });
        window.location.reload();
      } else { toast.error(result.error || "Save failed", { id: loadId }); }
    } catch (err) { toast.error("Server Error!", { id: loadId }); }
    finally { setIsSaving(false); }
  };

  return (
    <div className="space-y-3 text-[11px] animate-in fade-in duration-500">
      
      {/* TOP ACTION BAR */}
      <div className="flex justify-between bg-white p-3 rounded border shadow-sm no-print">
        <div className="flex gap-2">
          <button onClick={() => router.push('/billing/bill-book')} className="bg-red-600 text-white px-5 py-1.5 rounded font-black uppercase shadow hover:bg-red-700 transition-all">Show All Bills</button>
          <button onClick={() => window.location.reload()} className="bg-orange-500 text-white px-5 py-1.5 rounded font-black uppercase flex items-center gap-1 shadow hover:bg-orange-600 transition-all"><RotateCcw size={14}/> Reset Form</button>
        </div>
        <div className="flex gap-2">
          <button onClick={handleSave} disabled={isSaving || items.length === 0} className="bg-[#f39c12] text-white px-12 py-1.5 rounded font-black flex items-center gap-2 shadow-lg hover:bg-orange-600 active:scale-95 transition-all disabled:opacity-50">
            {isSaving ? <Loader2 className="animate-spin" size={16}/> : <Save size={16}/>} SAVE INVOICE
          </button>
          <button onClick={() => window.print()} className="bg-[#3498db] text-white px-8 py-1.5 rounded font-black flex items-center gap-2 shadow hover:bg-blue-600 transition-all"><Printer size={16}/> PRINT</button>
        </div>
      </div>

      <div className="bg-[#5d5fb1] text-white p-2 text-center font-black uppercase tracking-[5px] border border-indigo-400 italic shadow-md">
        Tax Invoice | Merchant Billing Entry Form
      </div>

      {/* HEADER SECTION */}
      <div className="bg-white p-6 border rounded shadow-sm grid grid-cols-1 md:grid-cols-4 lg:grid-cols-7 gap-4 items-end shadow-inner">
        <div><label className="text-gray-400 font-black uppercase text-[9px]">Series Type</label><input readOnly className="w-full border-2 border-slate-100 p-1.5 rounded bg-slate-50 font-bold" value="Tax Invoice" /></div>
        <div><label className="text-gray-400 font-black uppercase text-[9px]">Invoice No</label><input readOnly className="w-full border-2 border-slate-100 p-1.5 rounded bg-slate-100 font-black text-center text-indigo-700" value={header.invoiceNo} placeholder="[ AUTO ]" /></div>
        <div><label className="text-gray-400 font-black uppercase text-[9px]">Bill Date</label><input type="date" className="w-full border-2 border-slate-100 p-1.5 rounded font-bold outline-none focus:border-indigo-400" value={header.billDate} onChange={e => setHeader({...header, billDate: e.target.value})} /></div>
        <div className="lg:col-span-1"><label className="text-indigo-700 font-black uppercase text-[9px] flex items-center gap-1"><Landmark size={10}/> Party Name *</label>
          <select className="w-full border-2 border-indigo-100 p-1.5 rounded font-black text-blue-900 outline-none focus:border-indigo-500 shadow-sm" value={header.partyId} onChange={e => handlePartyChange(e.target.value)}>
            <option value="">-- Select Merchant --</option>
            {parties.map(p => <option key={p.id} value={p.id}>{p.tradeName} [{p.partyCode}]</option>)}
          </select>
        </div>
        <div><label className="text-gray-400 font-black uppercase text-[9px]">GST Type</label><input readOnly className="w-full border-2 border-slate-100 p-1.5 rounded bg-slate-50 uppercase font-bold" value={header.gstType} /></div>
        <div><label className="text-gray-400 font-black uppercase text-[9px]">State Name</label><input readOnly className="w-full border-2 border-slate-100 p-1.5 rounded bg-slate-50 uppercase font-bold" value={header.stateName} /></div>
        <div><label className="text-gray-400 font-black uppercase text-[9px]">Merchant GST</label><input readOnly className="w-full border-2 border-slate-100 p-1.5 rounded bg-slate-50 uppercase font-mono font-bold text-indigo-600" value={header.partyGst} /></div>
      </div>

      {/* 🔴 RED AUTOMATION BAR 🔴 */}
      <div className="grid grid-cols-1 md:grid-cols-5 gap-3 items-center no-print">
         <div className="col-span-1">
           <select className="w-full border-2 border-slate-200 p-2 rounded-lg bg-white font-black text-slate-600 outline-none" value={header.gstOn} onChange={e => setHeader({...header, gstOn: e.target.value})}>
             <option>GST On Both (Labour + Rent)</option>
             <option>Only Rent (Labour Exempt)</option>
           </select>
         </div>
         <button onClick={() => router.push(`/billing/pending-detail?partyId=${header.partyId}`)} className="bg-red-600 hover:bg-red-700 text-white py-2.5 rounded font-black text-[9px] uppercase shadow-lg flex items-center justify-center gap-2"><AlertCircle size={14}/> Pending Statement</button>
         <button onClick={handleImportData} disabled={loading} className="bg-red-600 hover:bg-red-700 text-white py-2.5 rounded font-black text-[9px] uppercase shadow-lg flex items-center justify-center gap-2">
            {loading ? <Loader2 className="animate-spin" size={14}/> : <Import size={14}/>} Import Data
         </button>
         <button onClick={calculatePeriod} className="bg-red-600 hover:bg-red-700 text-white py-2.5 rounded font-black text-[9px] uppercase shadow-lg flex items-center justify-center gap-2"><Calendar size={14}/> Calculate Period</button>
         <button onClick={() => toast.success("Party Rates logic applied")} className="bg-red-600 hover:bg-red-700 text-white py-2.5 rounded font-black text-[9px] uppercase shadow-lg flex items-center justify-center gap-2"><Tag size={14}/> Import Party Rates</button>
      </div>

      {/* DATA GRID */}
      <div className="bg-white border-2 border-slate-100 rounded-lg shadow-2xl overflow-x-auto min-h-[300px]">
        <table className="w-full border-collapse min-w-[1500px] text-left">
          <thead className="bg-[#b4b6e4] text-slate-800 uppercase font-black text-[9px] sticky top-0 z-10 shadow-md">
            <tr>
              <th className="p-3 border-r border-indigo-200">Lot No</th>
              <th className="p-3 border-r border-indigo-200">Marka</th>
              <th className="p-3 border-r border-indigo-200">Item Name</th>
              <th className="p-3 border-r border-indigo-200">Packing</th>
              <th className="p-3 border-r border-indigo-200">GP Ref</th>
              <th className="p-3 border-r border-indigo-200">In Date</th>
              <th className="p-3 border-r border-indigo-200">Out Date</th>
              <th className="p-3 border-r border-white bg-indigo-600 text-white text-center font-black">DAYS</th>
              <th className="p-3 border-r border-indigo-200 text-center">Billed Qty</th>
              <th className="p-3 border-r border-indigo-200 text-center">Rent Rate</th>
              <th className="p-3 border-r border-indigo-200 text-right bg-green-50 text-green-700">Rent Amt</th>
              <th className="p-3 border-r border-indigo-200 text-center">Lab Rate</th>
              <th className="p-3 text-right bg-green-50 text-green-700">Labour Amt</th>
            </tr>
          </thead>
          <tbody>
            {calculatedData.processedItems.length === 0 ? (
              <tr><td colSpan={13} className="p-24 text-center text-gray-300 italic font-medium uppercase tracking-[5px]">Select merchant and click 'Import Data' to populate unbilled dispatches</td></tr>
            ) : calculatedData.processedItems.map((it, idx) => (
              <tr key={it.lotId || `row-${idx}`} className="border-b hover:bg-indigo-50/50 transition-all font-bold group even:bg-slate-50/30">
                <td className="p-2 border-r border-slate-100 text-blue-700 font-black">{it.lotNo}</td>
                <td className="p-2 border-r border-slate-100 uppercase text-gray-400">{it.marka}</td>
                <td className="p-2 border-r border-slate-100 uppercase text-slate-700">{it.itemName}</td>
                <td className="p-2 border-r border-slate-100 uppercase text-gray-500 font-medium">{it.packing}</td>
                <td className="p-2 border-r border-slate-100 text-center font-mono text-indigo-500">{it.gpNo}</td>
                <td className="p-2 border-r border-slate-100 text-gray-400 font-mono text-[10px]">{formatDate(it.mrDate)}</td>
                <td className="p-2 border-r border-slate-100 text-gray-400 font-mono text-[10px]">{formatDate(it.gpDate)}</td>
                <td className="p-2 border-r border-slate-100 bg-indigo-50/80 text-center">
                  <input type="number" className="w-14 bg-transparent text-center font-black text-indigo-950 outline-none" value={it.prd} onChange={e => setItems(prev => prev.map((item, i) => i === idx ? {...item, prd: e.target.value} : item))} />
                </td>
                <td className="p-2 border-r border-slate-100 text-center text-slate-900">{it.qty}</td>
                <td className="p-2 border-r border-slate-100 text-center">
                   <input type="number" className="w-14 bg-transparent text-center font-bold text-slate-600 outline-none" value={it.rentRate} onChange={e => setItems(prev => prev.map((item, i) => i === idx ? {...item, rentRate: e.target.value} : item))} />
                </td>
                <td className="p-2 border-r border-slate-100 text-right text-green-700 bg-green-50/30">₹{Number(it.rentAmt || 0).toFixed(2)}</td>
                <td className="p-2 border-r border-slate-100 text-center">
                   <input type="number" className="w-14 bg-transparent text-center font-bold text-slate-600 outline-none" value={it.labRate} onChange={e => setItems(prev => prev.map((item, i) => i === idx ? {...item, labRate: e.target.value} : item))} />
                </td>
                <td className="p-2 text-right text-green-700 bg-green-50/30">₹{Number(it.labourAmt || 0).toFixed(2)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* FOOTER TOTALS GRID (All 7 Fields Restored) */}
      <div className="grid grid-cols-1 md:grid-cols-7 gap-4 items-end bg-white p-6 border-2 border-slate-100 rounded-xl shadow-lg no-print font-bold">
         <div>
            <label className="text-blue-600 uppercase text-[9px] font-black">CGST %</label>
            <input className="w-full border-2 border-blue-50 p-2 rounded-lg font-black text-center text-blue-700" value={taxRates.cgst} onChange={e => setTaxRates({...taxRates, cgst: parseFloat(e.target.value) || 0})} />
         </div>
         <div>
            <label className="text-blue-600 uppercase text-[9px] font-black">SGST %</label>
            <input className="w-full border-2 border-blue-50 p-2 rounded-lg font-black text-center text-blue-700" value={taxRates.sgst} onChange={e => setTaxRates({...taxRates, sgst: parseFloat(e.target.value) || 0})} />
         </div>
         <div>
            <label className="text-indigo-600 uppercase text-[9px] font-black">IGST %</label>
            <input className="w-full border-2 border-indigo-50 p-2 rounded-lg font-black text-center text-indigo-700" value={taxRates.igst} onChange={e => setTaxRates({...taxRates, igst: parseFloat(e.target.value) || 0})} />
         </div>
         <div>
            <label className="text-slate-400 uppercase text-[9px] font-black">Total GP Qty</label>
            <input readOnly className="w-full border-2 border-slate-100 p-2 rounded-lg font-black text-center bg-slate-50" value={calculatedData.totals.totalQty} />
         </div>
         <div>
            <label className="text-red-500 uppercase text-[9px] font-black">Discount (₹)</label>
            <input className="w-full border-2 border-red-50 p-2 rounded-lg font-black text-center text-red-600" value={discount} onChange={e => setDiscount(Number(e.target.value) || 0)} />
         </div>
         <div>
            <label className="text-slate-400 uppercase text-[9px] font-black">Gross Amount</label>
            <input readOnly className="w-full border-2 border-slate-100 p-2 rounded-lg font-black text-center bg-slate-50" value={calculatedData.totals.grossAmount.toFixed(2)} />
         </div>
         <div>
            <label className="text-slate-400 uppercase text-[9px] font-black">Round Off</label>
            <input readOnly className="w-full border-2 border-slate-100 p-2 rounded-lg font-black text-center bg-slate-50" value={calculatedData.totals.roundOff.toFixed(2)} />
         </div>
      </div>

      {/* FINAL BLUE TOTAL WIDGETS (All 6 Restored) */}
      <div className="grid grid-cols-2 md:grid-cols-6 gap-2">
         <div className="border p-2 bg-slate-50 rounded text-center shadow-inner"><p className="text-[9px] font-bold uppercase text-slate-500">CGST AMT</p><p className="font-black text-xs text-indigo-900">₹ {calculatedData.totals.cgstAmt.toFixed(2)}</p></div>
         <div className="border p-2 bg-slate-50 rounded text-center shadow-inner"><p className="text-[9px] font-bold uppercase text-slate-500">SGST AMT</p><p className="font-black text-xs text-indigo-900">₹ {calculatedData.totals.sgstAmt.toFixed(2)}</p></div>
         <div className="border p-2 bg-slate-50 rounded text-center shadow-inner"><p className="text-[9px] font-bold uppercase text-slate-500">IGST AMT</p><p className="font-black text-xs text-indigo-900">₹ {calculatedData.totals.igstAmt.toFixed(2)}</p></div>
         <div className="border p-2 bg-slate-50 rounded text-center shadow-inner"><p className="text-[9px] font-bold uppercase text-slate-500">LABOUR AMT</p><p className="font-black text-xs text-blue-600">₹ {calculatedData.totals.labourTotal.toFixed(2)}</p></div>
         <div className="border p-2 bg-slate-50 rounded text-center shadow-inner"><p className="text-[9px] font-bold uppercase text-slate-500">RENT AMT</p><p className="font-black text-xs text-green-600">₹ {calculatedData.totals.rentTotal.toFixed(2)}</p></div>
         <div className="bg-indigo-600 col-span-1 rounded-lg p-2 text-center shadow-lg transition-transform hover:scale-105">
            <p className="text-white font-bold uppercase text-[8px] tracking-widest">NET PAYABLE</p>
            <p className="text-white font-black text-lg italic">₹ {calculatedData.totals.netAmt.toLocaleString()}</p>
         </div>
      </div>

    </div>
  );
}
