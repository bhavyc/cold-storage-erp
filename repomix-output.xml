export async function POST(req: Request) {
  try {
    const { lotId, assignments } = await req.json();

    const result = await prisma.$transaction(async (tx) => {
      for (const row of assignments) {
        // 1. Pallet record ko Update ya Create karo (Upsert)
        // Kyunki PalletNo unique hai, hum purane record ko update karenge
        await tx.pallet.upsert({
          where: { palletNo: row.palletNo },
          update: {
            status: "Occupied",
            lotId: lotId,
            chamberId: row.chamberId,
            assignedQty: parseInt(row.qty),
            date: new Date() // Ab ye error nahi dega kyunki schema mein add kar diya hai
          },
          create: {
            palletNo: row.palletNo,
            status: "Occupied",
            lotId: lotId,
            chamberId: row.chamberId,
            assignedQty: parseInt(row.qty),
            date: new Date()
          }
        });
      }
    });

    return NextResponse.json({ success: true });
  } catch (error: any) {
    console.error("PALLET_SAVE_ERROR:", error);
    return NextResponse.json({ error: "Bhai, error aaya: " + error.message }, { status: 400 });
