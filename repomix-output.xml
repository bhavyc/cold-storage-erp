        </div>
        <button onClick={fetchLedgers} className="bg-red-600 text-white px-10 py-2 rounded font-black uppercase shadow-md hover:bg-red-700 transition-all">
          {loading ? <Loader2 className="animate-spin" size={16}/> : "SEARCH"}
