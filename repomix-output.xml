               <CheckCircle2 size={14} className="text-green-400"/> Bulk Inventory Management Module
            </p>
            <p className="font-bold text-[9px] uppercase">Loaded Records: {records.length}</p>
         </div>
         <div className="flex gap-4">
            <FileSpreadsheet className="cursor-pointer hover:text-green-400" size={16} />
            <Printer onClick={() => window.print()} className="cursor-pointer hover:text-red-400" size={16} />
         </div>
      </div>
    </div>
  );
}
