  const [filters, setFilters] = useState({
    fromLot: "",
    toLot: "",
    partyId: "All"
  });

  // Load Parties for dropdown
  useEffect(() => {
    fetch("/api/masters/party").then(res => res.json()).then(setParties);
  }, []);

