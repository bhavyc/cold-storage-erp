                  <td className="p-4 border-r border-slate-100 text-slate-600">{row.chamber.name}</td>
                  <td className="p-4 border-r border-slate-100 font-black text-indigo-700 text-sm">{row.palletNo}</td>
                  <td className="p-4 border-r border-slate-100 uppercase text-slate-800 truncate max-w-[200px]">{row.lot?.party?.tradeName || "---"}</td>
                  <td className="p-4 border-r border-slate-100 font-black text-blue-600">{row.lot?.lotNo || "---"}</td>
                  <td className="p-4 border-r border-slate-100 uppercase">
                    <div className="text-slate-700">{row.lot?.item?.name || "---"}</div>
                    <div className="text-[8px] text-gray-400">Marka: {row.lot?.marka || "NA"}</div>
