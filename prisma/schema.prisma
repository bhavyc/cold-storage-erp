generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  password  String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      UserRole @default(OPERATOR)
  partyId   String?
  party     Party?   @relation(fields: [partyId], references: [id])
}

model Category {
  id        String @id @default(uuid())
  code      String @unique
  name      String
  minLot    Int?
  maxLot    Int?
  maxMrGpNo Int?
  minMrGpNo Int?
  items     Item[]
}

model Unit {
  id                  String           @id @default(uuid())
  name                String
  type                String
  emptyWeight         Decimal          @default(0) @db.Decimal(10, 3)
  rateToContractorIn  Decimal          @default(0) @db.Decimal(10, 2)
  rateToContractorOut Decimal          @default(0) @db.Decimal(10, 2)
  code                String           @unique
  opBalance           Int              @default(0)
  itemConfigs         ItemUnitConfig[]
  lots                Lot[]
  partyRates          PartyItemRate[]
}

model Item {
  id         String           @id @default(uuid())
  code       String           @unique
  name       String
  categoryId String
  hsnCode    String?
  gstRate    Decimal          @default(18.0) @db.Decimal(5, 2)
  category   Category         @relation(fields: [categoryId], references: [id])
  itemUnits  ItemUnitConfig[]
  lots       Lot[]
  partyRates PartyItemRate[]
}

model ItemUnitConfig {
  id         String  @id @default(uuid())
  itemId     String
  unitId     String
  rentRate   Decimal @default(0) @db.Decimal(10, 2)
  labourRate Decimal @default(0) @db.Decimal(10, 2)
  lotValue   Decimal @default(0) @db.Decimal(10, 2)
  period     Int     @default(0)
  weight     Decimal @default(0) @db.Decimal(10, 3)
  item       Item    @relation(fields: [itemId], references: [id])
  unit       Unit    @relation(fields: [unitId], references: [id])
}

model Party {
  id                String               @id @default(uuid())
  partyCode         String               @unique
  type              String               @default("Sundry Debtors")
  tradeName         String
  proprietor        String?
  address           String?
  pincode           String?
  contactPerson     String?
  designation       String?
  email             String?
  mobiles           String[]
  gstType           String?
  stateName         String?
  stateCode         String?
  panNo             String?
  gstNo             String?
  bankName          String?
  branch            String?
  accountNo         String?
  ifsc              String?
  holderName        String?
  billNilLot        Boolean              @default(false)
  billMonthly       Boolean              @default(false)
  billTransport     Boolean              @default(false)
  billSpace         Boolean              @default(false)
  billBalance       Boolean              @default(false)
  billItemDay       Boolean              @default(false)
  billFixed         Boolean              @default(false)
  billCyclic        Boolean              @default(false)
  billDispatch      Boolean              @default(false)
  billItem          Boolean              @default(false)
  billGeneral       Boolean              @default(false)
  billWeekly        Boolean              @default(false)
  billUntouched     Boolean              @default(false)
  billLabour        Boolean              @default(false)
  billCA            Boolean              @default(false)
  billSlip          Boolean              @default(false)
  graceDays         Int                  @default(0)
  maxAllowedCredit  Decimal              @default(0) @db.Decimal(15, 2)
  aadharNo          String?
  openingBalance    Decimal              @default(0) @db.Decimal(15, 2)
  openingMode       String               @default("Debit")
  partyDocs         String?
  partyPhoto        String?
  paymentPreference String               @default("Credit")
  notifications     ClientNotification[]
  demands           Demand[]
  invoices          Invoice[]
  lots              Lot[]
  specialRates      PartyItemRate[]
  users             User[]
  vouchers          Voucher[]
}

model PartyItemRate {
  id      String  @id @default(uuid())
  partyId String
  itemId  String
  unitId  String
  csRent  Decimal @default(0) @db.Decimal(10, 2)
  csLab   Decimal @default(0) @db.Decimal(10, 2)
  caRent  Decimal @default(0) @db.Decimal(10, 2)
  caLab   Decimal @default(0) @db.Decimal(10, 2)
  freight Decimal @default(0) @db.Decimal(10, 2)
  item    Item    @relation(fields: [itemId], references: [id])
  party   Party   @relation(fields: [partyId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])
}

model Chamber {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  type          String
  capacityMode  String
  length        Decimal? @db.Decimal(10, 2)
  breadth       Decimal? @db.Decimal(10, 2)
  height        Decimal? @db.Decimal(10, 2)
  totalCapacity Int
  remarks       String?
  totalPallets  Int      @default(0)
  lots          Lot[]
  pallets       Pallet[]
}

model Pallet {
  id          String   @id @default(uuid())
  palletNo    String   @unique
  status      String   @default("Empty")
  lotId       String?
  chamberId   String
  assignedQty Int      @default(0)
  date        DateTime @default(now())
  chamber     Chamber  @relation(fields: [chamberId], references: [id])
  lot         Lot?     @relation(fields: [lotId], references: [id])
}

model Lot {
  id             String          @id @default(uuid())
  lotNo          String          @unique
  mrNo           String
  partyId        String
  itemId         String
  variety        String?
  unitId         String
  chamberId      String?
  floor          String?
  pole           String?
  palletNo       String?
  marka          String?
  pMarka         String?
  receivedQty    Int
  balanceQty     Int             @default(0)
  arrivalDate    DateTime
  uptoDate       DateTime?
  perUnitWgt     Decimal         @db.Decimal(10, 3)
  totalNetWgt    Decimal         @db.Decimal(10, 3)
  totalTareWgt   Decimal         @db.Decimal(10, 3)
  lotValue       Decimal?        @default(0) @db.Decimal(10, 2)
  demandItems    DemandItem[]
  invoiceItems   InvoiceItem[]
  inwardEntry    InwardEntry?
  chamber        Chamber?        @relation(fields: [chamberId], references: [id])
  item           Item            @relation(fields: [itemId], references: [id])
  party          Party           @relation(fields: [partyId], references: [id])
  unit           Unit            @relation(fields: [unitId], references: [id])
  outwardEntries OutwardEntry[]
  pallets        Pallet[]
  shiftingLogs   StockShifting[]
}

model InwardEntry {
  id             String   @id @default(uuid())
  lotId          String   @unique
  mrDate         DateTime @default(now())
  truckNo        String?
  deliveryPerson String?
  billingType    String?
  remarks        String?
  lot            Lot      @relation(fields: [lotId], references: [id])
}

model OutwardEntry {
  id                String   @id @default(uuid())
  gpNo              String   @unique
  lotId             String
  gpDate            DateTime @default(now())
  qty               Int
  netWeight         Decimal  @db.Decimal(10, 3)
  personName        String?
  vehicleNo         String?
  grNo              String?
  transportRequired Boolean  @default(false)
  lot               Lot      @relation(fields: [lotId], references: [id])
}

model StockShifting {
  id           String   @id @default(uuid())
  lotId        String
  date         DateTime @default(now())
  fromLocation String
  toLocation   String
  qty          Int
  lot          Lot      @relation(fields: [lotId], references: [id])
}

model Demand {
  id       String       @id @default(uuid())
  demandNo String       @unique
  date     DateTime     @default(now())
  partyId  String
  status   String       @default("Pending")
  party    Party        @relation(fields: [partyId], references: [id])
  items    DemandItem[]
}

model DemandItem {
  id       String @id @default(uuid())
  demandId String
  lotId    String
  qty      Int
  demand   Demand @relation(fields: [demandId], references: [id])
  lot      Lot    @relation(fields: [lotId], references: [id])
}

model Invoice {
  id           String        @id @default(uuid())
  invoiceNo    String        @unique
  date         DateTime      @default(now())
  partyId      String
  billingType  String
  isProforma   Boolean       @default(false)
  fromDate     DateTime?
  toDate       DateTime?
  totalQty     Int
  totalRent    Decimal       @db.Decimal(15, 2)
  totalLabour  Decimal       @db.Decimal(15, 2)
  taxableValue Decimal       @db.Decimal(15, 2)
  cgst         Decimal       @db.Decimal(15, 2)
  sgst         Decimal       @db.Decimal(15, 2)
  igst         Decimal       @db.Decimal(15, 2)
  roundOff     Decimal       @db.Decimal(10, 2)
  netAmount    Decimal       @db.Decimal(15, 2)
  irnNo        String?
  status       String        @default("Unpaid")
  party        Party         @relation(fields: [partyId], references: [id])
  items        InvoiceItem[]
}

model InvoiceItem {
  id         String  @id @default(uuid())
  invoiceId  String
  lotId      String
  qty        Int
  rentRate   Decimal @db.Decimal(10, 2)
  labourRate Decimal @db.Decimal(10, 2)
  rentAmt    Decimal @db.Decimal(15, 2)
  labourAmt  Decimal @db.Decimal(15, 2)
  period     Int
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  lot        Lot     @relation(fields: [lotId], references: [id])
}

model AccountGroup {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  reportType String
  groupType  String
  ledgers    Ledger[]
}

model Ledger {
  id             String        @id @default(uuid())
  code           String        @unique
  name           String
  groupId        String
  openingBalance Decimal       @default(0) @db.Decimal(15, 2)
  openingMode    String        @default("Debit")
  maxCredit      Decimal       @default(0) @db.Decimal(15, 2)
  group          AccountGroup  @relation(fields: [groupId], references: [id])
  tdsMasters     TDSMaster[]
  voucherEntries VoucherItem[]
}

model Voucher {
  id          String        @id @default(uuid())
  voucherNo   String        @unique
  date        DateTime      @default(now())
  partyId     String?
  group       String
  remarks     String?
  totalAmount Decimal       @db.Decimal(15, 2)
  vocType     String
  party       Party?        @relation(fields: [partyId], references: [id])
  items       VoucherItem[]
}

model VoucherItem {
  id        String  @id @default(uuid())
  voucherId String
  ledgerId  String
  debit     Decimal @default(0) @db.Decimal(15, 2)
  credit    Decimal @default(0) @db.Decimal(15, 2)
  narration String?
  ledger    Ledger  @relation(fields: [ledgerId], references: [id])
  voucher   Voucher @relation(fields: [voucherId], references: [id])
}

model TDSMaster {
  id            String  @id @default(uuid())
  section       String
  description   String
  panStatus     Boolean @default(true)
  tdsPercentage Decimal @default(0) @db.Decimal(5, 2)
  minThreshold  Decimal @default(0) @db.Decimal(15, 2)
  ledgerId      String?
  ledger        Ledger? @relation(fields: [ledgerId], references: [id])
}

model NarrationMaster {
  id          String @id @default(uuid())
  code        String @unique
  group       String
  vocType     String
  description String
}

model SystemSettings {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model SystemSequence {
  id         String   @id @default(uuid())
  entityType String   @unique
  prefix     String?
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model ClientNotification {
  id        String   @id @default(cuid())
  partyId   String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  party     Party    @relation(fields: [partyId], references: [id])

  @@index([partyId])
}

model OtpVerification {
  id        String   @id @default(uuid())
  mobile    String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
  GATEKEEPER
  ACCOUNTANT
  CUSTOMER
}

